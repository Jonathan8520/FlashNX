# Rust
/rust/target/
**/*.rs.bk
Cargo.lock

# C++ build
/cpp/build/
/cpp/*.elf
/cpp/*.nro
/cpp/*.nso
/cpp/*.nacp
/cpp/*.map
/cpp/*.pfs0

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Cloudflare Wrangler local cache (account info, build cache) — never commit.
.wrangler/

# Third-party submodule build artefacts (the submodule itself is tracked)
/third_party/ruffle/target/

# Local dev scratch — debug notes, WIP patches, test SWFs (never shipped).
# Distinct from third_party/ruffle (the tracked Ruffle submodule).
/temp/
/ruffle/

# Bundled test/sample SWFs are copyrighted games — keep them off the repo.
*.swf

# Self-contained build input (#106): whatever a developer drops in here is a
# game plus its companions, never repo content. `*.swf` above already covers the
# game itself; this also covers `<name>.files/` and anything beside it.
/cpp/romfs/

# Shortcut stub: built from stub/source/ at every FlashNX build, then turned into
# a byte array by bin2s. Both are artifacts, never edited by hand.
/stub/build/
/stub/flashnx_stub.elf
/stub/flashnx_stub.nro
/cpp/src/flashnx_stub.s

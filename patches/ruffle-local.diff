diff --git a/core/src/avm2/flashnx_gme.rs b/core/src/avm2/flashnx_gme.rs
new file mode 100644
index 000000000..a545c05c0
--- /dev/null
+++ b/core/src/avm2/flashnx_gme.rs
@@ -0,0 +1,546 @@
+//! FlashNX: game-music-emu run natively in place of its CrossBridge build.
+//!
+//! Super Mario Bros. Crossover plays its music and records its sound effects
+//! with libgme compiled to ActionScript by CrossBridge (FlasCC): Adobe's
+//! `sample.libgme` example, driven through one facade class, `libgme`, whose
+//! static methods each call the compiled C. Emulating the SNES sound chip that
+//! way costs ~60 ms for every 186 ms of music on the Switch at 1785 MHz, in a
+//! single `sampleData` handler, so the game stalls every ~11 frames and runs at
+//! 0.6-0.9x speed with its SNES music. Natively, the same library plays an SPC
+//! at ~7 % of a 400 MHz Mac (blargg's snes_spc README).
+//!
+//! FlashNX links game-music-emu 0.6.5 (cpp/third_party/gme) and registers its
+//! C API here (`set_api`). When a class named `libgme` with a static
+//! `gme_new_emu` is loaded, its static methods that take or make an emulator are
+//! replaced by the natives below, keeping their ABC signatures (arguments are
+//! coerced as declared). The emulators live outside the movie's memory: the
+//! `int` the game holds is a handle into `EMUS`, never a pointer into domain
+//! memory, so every facade method that takes one is replaced, the ones FlashNX
+//! cannot honour by a neutral answer. Data still travels through domain memory
+//! (`gme_load_data` reads the file the game copied there, `gme_play_float`
+//! writes the samples where the compiled code wrote them).
+
+use super::activation::Activation;
+use super::class::Class;
+use super::method::{Method, NativeMethodImpl};
+use super::parameters::ParametersExt;
+use super::traits::{Trait, TraitKind};
+use crate::avm2::{Error, Value};
+use crate::string::AvmString;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{Mutex, OnceLock};
+
+/// The emulator types the facade's getters name (`gme_spc_type`...). The game
+/// only passes them back to `gme_new_emu`, so small numbers stand in for the C
+/// pointers.
+pub const KIND_GBS: u8 = 1;
+pub const KIND_KSS: u8 = 2;
+pub const KIND_NSF: u8 = 3;
+pub const KIND_NSFE: u8 = 4;
+pub const KIND_SAP: u8 = 5;
+pub const KIND_SPC: u8 = 6;
+
+/// libgme's C API, as FlashNX calls it (rust/src/gme.rs). An emulator is the
+/// address of its `Music_Emu`; errors are libgme's `gme_err_t` strings.
+#[derive(Clone, Copy)]
+pub struct GmeApi {
+    pub new_emu: fn(kind: u8, sample_rate: i32) -> usize,
+    pub open_data: fn(data: &[u8], sample_rate: i32) -> Result<(usize, u8), String>,
+    pub delete: fn(emu: usize),
+    pub load_data: fn(emu: usize, data: &[u8]) -> Option<String>,
+    pub start_track: fn(emu: usize, track: i32) -> Option<String>,
+    pub play: fn(emu: usize, out: &mut [i16]) -> Option<String>,
+    pub track_ended: fn(emu: usize) -> bool,
+    pub tell: fn(emu: usize) -> i32,
+    pub seek: fn(emu: usize, msec: i32) -> Option<String>,
+    pub set_tempo: fn(emu: usize, tempo: f64),
+    pub set_fade: fn(emu: usize, start_msec: i32),
+    pub set_stereo_depth: fn(emu: usize, depth: f64),
+    pub track_count: fn(emu: usize) -> i32,
+    pub track_info: fn(emu: usize, track: i32) -> Option<String>,
+    pub ignore_silence: fn(emu: usize, ignore: bool),
+    pub voice_count: fn(emu: usize) -> i32,
+    pub mute_voice: fn(emu: usize, index: i32, mute: bool),
+    pub mute_voices: fn(emu: usize, mask: i32),
+    pub warning: fn(emu: usize) -> Option<String>,
+}
+
+static API: OnceLock<GmeApi> = OnceLock::new();
+
+/// On (default) or off (`gmenative.off` marker): off, the CrossBridge build
+/// runs as before.
+static ENABLED: AtomicBool = AtomicBool::new(true);
+
+/// FlashNX gives the API once, at start-up.
+pub fn set_api(api: GmeApi) {
+    let _ = API.set(api);
+}
+
+pub fn set_enabled(enabled: bool) {
+    ENABLED.store(enabled, Ordering::Relaxed);
+}
+
+fn api() -> Option<&'static GmeApi> {
+    if ENABLED.load(Ordering::Relaxed) {
+        API.get()
+    } else {
+        None
+    }
+}
+
+/// Handles start here, far from anything the game could mistake for one of
+/// its own small numbers ("NX" in the high bytes).
+const HANDLE_BASE: i32 = 0x4E58_0000;
+
+/// Live emulators: (address, kind) by handle, `None` once deleted.
+static EMUS: Mutex<Vec<Option<(usize, u8)>>> = Mutex::new(Vec::new());
+
+fn add_emu(emu: usize, kind: u8) -> i32 {
+    let mut emus = EMUS.lock().unwrap();
+    emus.push(Some((emu, kind)));
+    HANDLE_BASE + (emus.len() as i32 - 1)
+}
+
+fn emu_of(handle: i32) -> Option<(usize, u8)> {
+    let index = handle.checked_sub(HANDLE_BASE)?;
+    let emus = EMUS.lock().unwrap();
+    let found = emus.get(usize::try_from(index).ok()?).copied().flatten();
+    if found.is_none() {
+        static SAID: AtomicBool = AtomicBool::new(false);
+        if !SAID.swap(true, Ordering::Relaxed) {
+            tracing::warn!("gme: handle {handle:#x} is not a native emulator, ignored");
+        }
+    }
+    found
+}
+
+/// FlashNX: the game ended (`ruffle_shutdown`): every emulator it left goes.
+pub fn reset() {
+    let emus = std::mem::take(&mut *EMUS.lock().unwrap());
+    if let Some(api) = API.get() {
+        for (emu, _) in emus.into_iter().flatten() {
+            (api.delete)(emu);
+        }
+    }
+}
+
+/// Samples made and the time it took, said every `PLAY_REPORT` calls.
+static PLAY_CALLS: AtomicU64 = AtomicU64::new(0);
+static PLAY_SAMPLES: AtomicU64 = AtomicU64::new(0);
+static PLAY_US: AtomicU64 = AtomicU64::new(0);
+const PLAY_REPORT: u64 = 256;
+
+fn note_play(samples: usize, started: std::time::Instant) {
+    PLAY_SAMPLES.fetch_add(samples as u64, Ordering::Relaxed);
+    PLAY_US.fetch_add(started.elapsed().as_micros() as u64, Ordering::Relaxed);
+    if PLAY_CALLS.fetch_add(1, Ordering::Relaxed) + 1 == PLAY_REPORT {
+        let samples = PLAY_SAMPLES.swap(0, Ordering::Relaxed);
+        let us = PLAY_US.swap(0, Ordering::Relaxed);
+        PLAY_CALLS.store(0, Ordering::Relaxed);
+        tracing::info!(
+            "gme: native play, {PLAY_REPORT} calls, {} samples, {} us a call",
+            samples,
+            us / PLAY_REPORT
+        );
+    }
+}
+
+fn error_value<'gc>(activation: &mut Activation<'_, 'gc>, error: Option<String>) -> Value<'gc> {
+    match error {
+        Some(error) => AvmString::new_utf8(activation.gc(), error).into(),
+        None => Value::Null,
+    }
+}
+
+/// Domain memory of the calling movie: CrossBridge's `CModule.ram`.
+fn read_memory<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    ptr: i32,
+    len: i32,
+) -> Result<Vec<u8>, String> {
+    let domain = activation.caller_domain().ok_or("FlashNX gme: no caller domain")?;
+    let memory = domain.domain_memory();
+    let storage = memory.storage();
+    let bytes = storage.bytes();
+    let start = usize::try_from(ptr).map_err(|_| "FlashNX gme: bad pointer")?;
+    let len = usize::try_from(len).map_err(|_| "FlashNX gme: bad length")?;
+    let end = start.checked_add(len).ok_or("FlashNX gme: bad length")?;
+    bytes
+        .get(start..end)
+        .map(|b| b.to_vec())
+        .ok_or_else(|| "FlashNX gme: read past domain memory".to_string())
+}
+
+/// Plays `count` samples into domain memory: as 16-bit samples at `out`,
+/// and, with `out_float`, as floats there too (`gme_play_float`, Super Mario
+/// Bros. Crossover's addition to libgme: each sample times 1/32768).
+fn play_into<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    api: &GmeApi,
+    emu: usize,
+    count: i32,
+    out: i32,
+    out_float: Option<i32>,
+) -> Result<Option<String>, String> {
+    let started = std::time::Instant::now();
+    let count = usize::try_from(count).unwrap_or(0);
+    let mut samples = vec![0i16; count];
+    let error = (api.play)(emu, &mut samples);
+
+    let domain = activation.caller_domain().ok_or("FlashNX gme: no caller domain")?;
+    let memory = domain.domain_memory();
+    let mut storage = memory.storage_mut();
+    let bytes = storage.bytes_mut();
+    let short_at = usize::try_from(out).map_err(|_| "FlashNX gme: bad pointer")?;
+    let shorts = bytes
+        .get_mut(short_at..short_at + count * 2)
+        .ok_or("FlashNX gme: write past domain memory")?;
+    for (chunk, sample) in shorts.chunks_exact_mut(2).zip(&samples) {
+        chunk.copy_from_slice(&sample.to_le_bytes());
+    }
+    if let Some(out_float) = out_float {
+        let float_at = usize::try_from(out_float).map_err(|_| "FlashNX gme: bad pointer")?;
+        let floats = bytes
+            .get_mut(float_at..float_at + count * 4)
+            .ok_or("FlashNX gme: write past domain memory")?;
+        for (chunk, sample) in floats.chunks_exact_mut(4).zip(&samples) {
+            // Exact: a 16-bit sample over a power of two fits an f32.
+            let value = (*sample as f64 * 0.000030517578125) as f32;
+            chunk.copy_from_slice(&value.to_le_bytes());
+        }
+    }
+    note_play(count, started);
+    Ok(error)
+}
+
+macro_rules! with_emu {
+    ($args:ident, $fallback:expr, |$api:ident, $emu:ident, $kind:ident| $body:expr) => {{
+        let Some($api) = api() else { return Ok($fallback) };
+        let Some(($emu, $kind)) = emu_of($args.get_i32(0)) else { return Ok($fallback) };
+        let _ = $kind;
+        $body
+    }};
+}
+
+fn kind_getter<'gc>(kind: u8) -> Value<'gc> {
+    Value::Integer(kind as i32)
+}
+
+fn gme_gbs_type<'gc>(_: &mut Activation<'_, 'gc>, _: Value<'gc>, _: &[Value<'gc>]) -> Result<Value<'gc>, Error<'gc>> {
+    Ok(kind_getter(KIND_GBS))
+}
+fn gme_kss_type<'gc>(_: &mut Activation<'_, 'gc>, _: Value<'gc>, _: &[Value<'gc>]) -> Result<Value<'gc>, Error<'gc>> {
+    Ok(kind_getter(KIND_KSS))
+}
+fn gme_nsf_type<'gc>(_: &mut Activation<'_, 'gc>, _: Value<'gc>, _: &[Value<'gc>]) -> Result<Value<'gc>, Error<'gc>> {
+    Ok(kind_getter(KIND_NSF))
+}
+fn gme_nsfe_type<'gc>(_: &mut Activation<'_, 'gc>, _: Value<'gc>, _: &[Value<'gc>]) -> Result<Value<'gc>, Error<'gc>> {
+    Ok(kind_getter(KIND_NSFE))
+}
+fn gme_sap_type<'gc>(_: &mut Activation<'_, 'gc>, _: Value<'gc>, _: &[Value<'gc>]) -> Result<Value<'gc>, Error<'gc>> {
+    Ok(kind_getter(KIND_SAP))
+}
+fn gme_spc_type<'gc>(_: &mut Activation<'_, 'gc>, _: Value<'gc>, _: &[Value<'gc>]) -> Result<Value<'gc>, Error<'gc>> {
+    Ok(kind_getter(KIND_SPC))
+}
+
+/// `gme_new_emu(type, sample_rate)`: 0 when the type is not one of ours, as
+/// libgme answers NULL.
+fn gme_new_emu<'gc>(_: &mut Activation<'_, 'gc>, _: Value<'gc>, args: &[Value<'gc>]) -> Result<Value<'gc>, Error<'gc>> {
+    let Some(api) = api() else { return Ok(Value::Integer(0)) };
+    let kind = args.get_i32(0);
+    if !(KIND_GBS as i32..=KIND_SPC as i32).contains(&kind) {
+        return Ok(Value::Integer(0));
+    }
+    let emu = (api.new_emu)(kind as u8, args.get_i32(1));
+    if emu == 0 {
+        return Ok(Value::Integer(0));
+    }
+    tracing::info!("gme: native emulator, type {kind}");
+    Ok(Value::Integer(add_emu(emu, kind as u8)))
+}
+
+/// `gme_open_data(data, size, out, sample_rate)`: the handle is written where
+/// libgme would have written the `Music_Emu*`.
+fn gme_open_data<'gc>(activation: &mut Activation<'_, 'gc>, _: Value<'gc>, args: &[Value<'gc>]) -> Result<Value<'gc>, Error<'gc>> {
+    let Some(api) = api() else { return Ok(Value::Null) };
+    let result = read_memory(activation, args.get_i32(0), args.get_i32(1))
+        .and_then(|data| (api.open_data)(&data, args.get_i32(3)));
+    let error = match result {
+        Ok((emu, kind)) => {
+            let handle = add_emu(emu, kind);
+            let domain = activation.caller_domain();
+            let at = usize::try_from(args.get_i32(2)).ok();
+            match (domain, at) {
+                (Some(domain), Some(at)) => {
+                    let memory = domain.domain_memory();
+                    let mut storage = memory.storage_mut();
+                    match storage.bytes_mut().get_mut(at..at + 4) {
+                        Some(out) => {
+                            out.copy_from_slice(&handle.to_le_bytes());
+                            None
+                        }
+                        None => Some("FlashNX gme: write past domain memory".to_string()),
+                    }
+                }
+                _ => Some("FlashNX gme: bad pointer".to_string()),
+            }
+        }
+        Err(error) => Some(error),
+    };

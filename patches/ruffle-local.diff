+    fn bits_and_pressure() {
+        let mut ops = std::vec![
+            GetLocal { index: 1 },
+            PushInt { value: 3 },
+            LShift,
+            GetLocal { index: 2 },
+            PushInt { value: 255 },
+            BitAnd,
+            BitOr,
+            PushInt { value: 2 },
+            URShift,
+            SetLocal { index: 3 },
+            GetLocal { index: 1 },
+            PushInt { value: 0 },
+            URShift,
+            CoerceI,
+            SetLocal { index: 3 },
+        ];
+        // Nine bytes on the stack: more than `POOL`.
+        for k in 0..9 {
+            ops.push(GetLocal { index: 1 });
+            ops.push(PushInt { value: k });
+            ops.push(Add);
+            ops.push(Li8);
+        }
+        for _ in 0..8 {
+            ops.push(Add);
+        }
+        ops.push(CoerceI);
+        ops.push(SetLocal { index: 3 });
+        ops.push(GetLocal { index: 1 });
+        ops.push(Dup);
+        ops.push(Add);
+        ops.push(GetLocal { index: 2 });
+        ops.push(Swap);
+        ops.push(Subtract);
+        ops.push(CoerceI);
+        ops.push(SetLocal { index: 3 });
+        ops.push(RET);
+        let t = build("bits", &ops, &[Ty::Any, Ty::Int, Ty::Int, Ty::Any], 12);
+        assert!(!t.wrap[8]); // by 2: an int whatever it reads
+        assert!(t.wrap[12]); // by 0, read as ToInt32
+        let first_add = 15 + 4 * 9;
+        for k in 0..8 {
+            assert!(t.wrap[first_add + k], "add {k}");
+        }
+    }
+
+    /// `b2Math.b2Max(a:Number, b:Number):Number { return a > b ? a : b; }`.
+    fn b2max() -> CalleeCopy<'static> {
+        let body = std::vec![
+            GetLocal { index: 1 },
+            GetLocal { index: 2 },
+            GreaterThan,
+            IfFalse { offset: 6 },
+            GetLocal { index: 1 },
+            Jump { offset: 7 },
+            GetLocal { index: 2 },
+            ReturnValue { return_type: None },
+        ];
+        let (depth, _) = shape(&body, 2, &FnvHashMap::default()).unwrap();
+        CalleeCopy {
+            at: 0,
+            n: 2,
+            push: true,
+            body,
+            depth,
+            locals: 3,
+            conv: std::vec![Some(CoerceD), Some(CoerceD)],
+            expect: 0x1000,
+        }
+    }
+
+    /// The callee after its guard, run through `shape`, `analyze` and
+    /// `emit`: depths at each way out of a guard as the call leaves them,
+    /// returns that drop what the callee left below them, the method's ops
+    /// for each of its own, none for a callee's.
+    #[test]
+    fn callee_copied() {
+        // x = max(a, b); max(x, a) dropped; then a loop around a third.
+        let ops = [
+            GetLocal { index: 0 },
+            GetLocal { index: 1 },
+            GetLocal { index: 2 },
+            CallMethod { index: 5, num_args: 2, push_return_value: true },
+            SetLocal { index: 3 },
+            GetLocal { index: 0 },
+            GetLocal { index: 3 },
+            GetLocal { index: 1 },
+            CallMethod { index: 5, num_args: 2, push_return_value: false },
+            PushInt { value: 0 },
+            SetLocal { index: 4 },
+            GetLocal { index: 0 },
+            GetLocal { index: 4 },
+            GetLocal { index: 4 },
+            CallMethod { index: 6, num_args: 2, push_return_value: false },
+            IncLocalI { index: 4 },
+            GetLocal { index: 4 },
+            PushInt { value: 10 },
+            LessThan,
+            IfTrue { offset: 11 },
+            RET,
+        ];
+        let nl = 5;
+        let (depth, _) = shape(&ops, 3, &FnvHashMap::default()).unwrap();
+        let mut first = b2max();
+        first.at = 3;
+        let mut second = b2max();
+        second.at = 8;
+        second.push = false;
+        // `(a, b):void { a = a + b; }` with an int under its return.
+        let body = std::vec![
+            PushInt { value: 1 },
+            GetLocal { index: 1 },
+            GetLocal { index: 2 },
+            Add,
+            SetLocal { index: 1 },
+            ReturnVoid { return_type: None },
+            Nop,
+        ];
+        let (third_depth, _) = shape(&body, 3, &FnvHashMap::default()).unwrap();
+        let third = CalleeCopy {
+            at: 14,
+            n: 2,
+            push: false,
+            body,
+            depth: third_depth,
+            locals: 4,
+            conv: std::vec![None, None],
+            expect: 0x2000,
+        };
+        let (sops, orig, guards, expect) = splice(&ops, &depth, nl, &[first, second, third]);
+        assert_eq!(guards.len(), 3);
+        let (sdepth, starget) = shape(&sops, 3 + INLINE_MAX_STACK, &guards).unwrap();
+        for (&g, &cont) in &guards {
+            let Op::CallMethod { num_args, push_return_value, .. } = sops[g] else { panic!("guard {g}") };
+            let d = sdepth[g] as usize;
+            assert_eq!(sdepth[cont] as usize, d - num_args as usize - 1 + push_return_value as usize, "after {g}");
+            assert_eq!(sdepth[g + 1] as usize, d, "into {g}");
+            assert!(starget[g + 1] && starget[cont]);
+            assert_ne!(expect[g], 0);
+            // On after the call: the method's op after it.
+            assert_eq!(orig[cont], orig[g] + 1);
+        }
+        // Every op of the method is there, in order, once.
+        let mine: Vec<u32> = orig.iter().copied().filter(|&o| o != u32::MAX).collect();
+        assert_eq!(mine, (0..ops.len() as u32).collect::<Vec<_>>());
+        // The loop goes back to its own start.
+        let back = sops.iter().position(|op| matches!(op, IfTrue { .. })).unwrap();
+        let IfTrue { offset } = sops[back] else { unreachable!() };
+        assert_eq!(orig[offset], 11);
+        // The callee's locals are the caller's slots above its own locals.
+        assert!(sops.iter().any(|op| matches!(op, GetLocal { index } if *index >= nl as u32)));
+        let mut entry = std::vec![Ty::Any; nl];
+        entry[1] = Ty::Num;
+        entry[2] = Ty::Num;
+        build_with("inline", &sops, &entry, 3 + INLINE_MAX_STACK, &guards);
+    }
+}

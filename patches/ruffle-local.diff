+/// A new game starts: the previous one's player, and every method compiled
+/// for it, are gone, so its code memory is free again. The measured layout
+/// is Ruffle's, not the game's: it stays.
+pub fn reset() {
+    let s = state();
+    s.used = 0;
+    s.compiled = 0;
+    s.rejected = 0;
+    s.reasons.clear();
+    s.deopts = 0;
+    s.deopt_ops.clear();
+    s.runs = 0;
+    s.typed_ops = 0;
+    s.all_ops = 0;
+    s.typefails = 0;
+    s.typefail_ops.clear();
+    s.map.clear();
+    // Its ops' `Gc`s were the previous player's: never read again.
+    s.infos.clear();
+    s.inl_sites = 0;
+    s.inl_methods = 0;
+    s.inl_refused.clear();
+}
+
+/// Counters since the last call, then reset (the totals stay).
+pub fn report() -> String {
+    let s = state();
+    if s.init == 0 {
+        return String::new();
+    }
+    let top = |m: &FnvHashMap<String, u64>| {
+        let mut v: Vec<_> = m.iter().collect();
+        v.sort_by(|a, b| b.1.cmp(a.1));
+        v.iter().take(8).map(|(k, n)| format!("{k} x{n}")).collect::<Vec<_>>().join(", ")
+    };
+    let l = &s.layout;
+    let out = format!(
+"{} (rc=0x{:x}, bool {}, numbers {}, setslot {}, getslot {:?} slots@{}/{} {}, crossbridge {}), {} methods compiled ({} KB), {} rejected [{}], {} deopts [{}], {} runs, calls {} direct / {} slow [{}] [{}], domain memory views {} ({} refused), ints {} ({} of {} ops typed, check {}, {} wrong [{}])",
+        if s.init == 1 { "on" } else { "UNAVAILABLE" },
+        s.init_rc,
+        if l.bool_ok { "inline" } else { "helper" },
+        if l.num_ok { "inline" } else { "helper" },
+        if l.header_ok { "inline" } else { "helper" },
+        l.obj_tags,
+        l.slots_ptr_off,
+        l.slots_len_off,
+        l.obj_fail,
+        if CROSSBRIDGE.load(AtomicOrdering::Relaxed) { "on" } else { "off" },
+        s.compiled,
+        s.used / 1024,
+        s.rejected,
+        top(&s.reasons),
+        s.deopts,
+        top(&s.deopt_ops),
+        s.runs,
+        s.calls_direct,
+        s.calls_slow,
+        SLOW_WHY
+            .iter()
+            .zip(s.slow_why.iter())
+            .filter(|(_, n)| **n > 0)
+            .map(|(k, n)| format!("{k} x{n}"))
+            .collect::<Vec<_>>()
+            .join(", "),
+        top(&s.slow_names),
+        s.dm_views,
+        s.dm_refused,
+        if INTS.load(AtomicOrdering::Relaxed) { "on" } else { "off" },
+        s.typed_ops,
+        s.all_ops,
+        if CHECK.load(AtomicOrdering::Relaxed) { "on" } else { "off" },
+        s.typefails,
+        top(&s.typefail_ops)
+    );
+    // Callees copied in place (`splice`): sites and methods so far, guards
+    // since the last report.
+    let out = format!(
+        "{out}, inline {} ({} sites in {} methods, guards {} copy / {} call, not copied [{}])",
+        if INLINE.load(AtomicOrdering::Relaxed) { "on" } else { "off" },
+        s.inl_sites,
+        s.inl_methods,
+        s.inl_hits,
+        s.inl_misses,
+        top(&s.inl_refused)
+    );
+    s.inl_hits = 0;
+    s.inl_misses = 0;
+    s.slow_why = [0; SLOW_WHY.len()];
+    s.slow_names.clear();
+    s.runs = 0;
+    s.calls_direct = 0;
+    s.calls_slow = 0;
+    s.dm_views = 0;
+    s.dm_refused = 0;
+    // Measuring builds: the op kinds compiled code ran through their helper
+    // most often since the last report (`HELPER_N`).
+    #[cfg(feature = "flashnx_instr")]
+    let out = {
+        let mut counts: Vec<(u64, usize)> = (0..256)
+            .map(|k| (HELPER_N[k].swap(0, AtomicOrdering::Relaxed), k))
+            .filter(|(n, _)| *n > 0)
+            .collect();
+        counts.sort_by(|a, b| b.0.cmp(&a.0));
+        let total: u64 = counts.iter().map(|(n, _)| n).sum();
+        let top = counts
+            .iter()
+            .take(14)
+            .map(|(n, k)| format!("{} x{n}", s.kind_names.get(k).map_or("?", |n| n.as_str())))
+            .collect::<Vec<_>>()
+            .join(", ");
+        format!("{out}, helpers {total} [{top}]")
+    };
+    out
+}

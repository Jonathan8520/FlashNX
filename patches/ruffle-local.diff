+/// FlashNX: run `f` on every dirty orphan, in orphan-list order, without
+/// iterating the list. An orphan that becomes dirty while this runs is taken
+/// in if it comes later in the list (iterating the list would have reached
+/// it), left queued for the next pass otherwise (iterating would have passed
+/// it already). Returns the orphans `f` ran on.
+fn for_each_dirty_orphan<'gc>(
+    context: &mut UpdateContext<'gc>,
+    mut f: impl FnMut(DisplayObject<'gc>, &mut UpdateContext<'gc>),
+) -> Vec<DisplayObject<'gc>> {
+    use crate::display_object::{queue_dirty_orphan, take_dirty_orphans};
+    let mut pending = context
+        .orphan_manager
+        .resolve_dirty(context.gc(), &take_dirty_orphans());
+    let mut done = Vec::with_capacity(pending.len());
+    let mut late = Vec::new();
+    let mut i = 0;
+    while i < pending.len() {
+        let (seq, orphan) = pending[i];
+        i += 1;
+        f(orphan, context);
+        done.push(orphan);
+        let fresh = take_dirty_orphans();
+        if fresh.is_empty() {
+            continue;
+        }
+        for (s, o) in context.orphan_manager.resolve_dirty(context.gc(), &fresh) {
+            if s > seq {
+                let ahead = &pending[i..];
+                if !ahead.iter().any(|e| e.0 == s) {
+                    let at = i + ahead.partition_point(|e| e.0 < s);
+                    pending.insert(at, (s, o));
+                }
+            } else {
+                late.push(o);
+            }
+        }
+    }
+    for o in late {
+        queue_dirty_orphan(o);
+    }
+    done
+}

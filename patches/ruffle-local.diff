+fn gme_delete<'gc>(_: &mut Activation<'_, 'gc>, _: Value<'gc>, args: &[Value<'gc>]) -> Result<Value<'gc>, Error<'gc>> {
+    let Some(api) = api() else { return Ok(Value::Undefined) };
+    let handle = args.get_i32(0);
+    let taken = handle.checked_sub(HANDLE_BASE).and_then(|index| {
+        let mut emus = EMUS.lock().unwrap();
+        emus.get_mut(usize::try_from(index).ok()?)?.take()
+    });
+    if let Some((emu, _)) = taken {
+        (api.delete)(emu);
+    }
+    Ok(Value::Undefined)
+}

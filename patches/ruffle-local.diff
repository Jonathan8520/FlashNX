+package {
+    import flash.display.MovieClip;
+
+    // Linked to the "Child" symbol, which "Page" places on its frame 2. The
+    // trace marks when this object is constructed relative to Page's frame
+    // script: before it on Flash Player, after it on a regressed Ruffle.
+    public class Child extends MovieClip {
+
+        public function Child() {
+            super();
+            trace("Child: ctor (name=" + name + ")");
+        }
+    }
+}
diff --git a/tests/tests/swfs/avm2/swf_9_goto_in_constructor_children/Main.as b/tests/tests/swfs/avm2/swf_9_goto_in_constructor_children/Main.as

+
+fn finalize_pass<'gc>(
+    fc: &'gc gc_arena::Finalization<'gc>,
+    root: &'gc GcRoot<'gc>,
+) -> (bool, Vec<SoundHandle>) {
+    if !root.data.borrow().library.has_released() {
+        return (false, Vec::new());
+    }
+    root.data.borrow_mut(fc).library.finalize_released(fc)
+}

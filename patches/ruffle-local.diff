+fn native_for(name: &str) -> Option<NativeMethodImpl> {
+    Some(match name {
+        "gme_gbs_type" => gme_gbs_type,
+        "gme_kss_type" => gme_kss_type,
+        "gme_nsf_type" => gme_nsf_type,
+        "gme_nsfe_type" => gme_nsfe_type,
+        "gme_sap_type" => gme_sap_type,
+        "gme_spc_type" => gme_spc_type,
+        "gme_new_emu" => gme_new_emu,
+        "gme_open_data" => gme_open_data,
+        "gme_delete" => gme_delete,
+        "gme_load_data" => gme_load_data,
+        "gme_start_track" => gme_start_track,
+        "gme_play" => gme_play,
+        "gme_play_float" => gme_play_float,
+        "gme_track_ended" => gme_track_ended,
+        "gme_tell" => gme_tell,
+        "gme_seek" => gme_seek,
+        "gme_set_tempo" => gme_set_tempo,
+        "gme_set_fade" => gme_set_fade,
+        "gme_set_stereo_depth" => gme_set_stereo_depth,
+        "gme_track_count" => gme_track_count,
+        "gme_track_info" => gme_track_info,
+        "gme_ignore_silence" => gme_ignore_silence,
+        "gme_voice_count" => gme_voice_count,
+        "gme_mute_voice" => gme_mute_voice,
+        "gme_mute_voices" => gme_mute_voices,
+        "gme_warning" => gme_warning,
+        "gme_type" => gme_type,
+        "gme_open_file" | "gme_load_file" | "gme_load_m3u" | "gme_load_m3u_data"
+        | "gme_load_custom" => unsupported,
+        "gme_voice_names" | "gme_user_data" => unsupported_int,
+        "gme_equalizer" | "gme_set_equalizer" | "gme_set_user_data" | "gme_set_user_cleanup" => {
+            unsupported_void
+        }
+        _ => return None,
+    })
+}

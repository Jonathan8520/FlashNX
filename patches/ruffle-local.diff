+pub fn jit_map_text() -> String {
+    #[cfg(feature = "flashnx_jit")]
+    {
+        jit::map_text()
+    }
+    #[cfg(not(feature = "flashnx_jit"))]
+    {
+        String::new()
+    }
+}
+
+/// FlashNX: one line of JIT counters (`jit:`), empty without the JIT.
+pub fn jit_report() -> String {

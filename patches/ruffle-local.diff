+    inl_sites: u64,
+    inl_methods: u64,
+    inl_hits: u64,
+    inl_misses: u64,
+    inl_refused: FnvHashMap<String, u64>,
+    /// The name of each op kind met while compiling, for `HELPER_N`.
+    #[cfg(feature = "flashnx_instr")]
+    kind_names: FnvHashMap<usize, String>,
+}
+
+/// Measuring builds: how many times compiled code handed each op kind to its
+/// helper (`h_op`), that is ran it through the interpreter's handler rather
+/// than as native code, since the last `report`.
+///
+/// Read with what a helper costs: ~15-20 ns, not the 150-250 ns guessed
+/// first. 3D Mario Racing ran ~230 000 helpers a frame (2026-10-15); making
+/// mixed int/Number arithmetic, Divide and Negate native removed ~57 000 of
+/// them and saved 1-3 ms of a 77 ms frame, in the noise, so it was taken out
+/// again. Its time is the sheer volume of ops and their memory traffic.
+#[cfg(feature = "flashnx_instr")]
+static HELPER_N: [AtomicU64; 256] = [const { AtomicU64::new(0) }; 256];
+
+/// Keep the op address map (`map`); off unless the profiling build asks.
+static MAP: AtomicBool = AtomicBool::new(false);
+
+pub fn set_map(on: bool) {
+    MAP.store(on, AtomicOrdering::Relaxed);
+}
+
+/// The op address map of the code compiled since the last `reset`, one
+/// `<address hex> <op>` line per op, in address order.
+pub fn map_text() -> String {
+    let s = state();
+    let mut out = String::with_capacity(s.map.len() * 24);
+    for (addr, name) in &s.map {
+        out.push_str(&format!("{addr:x} {name}
+"));
+    }
+    out
+}

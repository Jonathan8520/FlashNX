+/// FlashNX: `sort_inner`, with each value's index in the source array handed
+/// to `sort_func` beside it, so a comparison can remember something per
+/// element (`sort_on`'s field values). Everything else is `sort_inner`'s.
+fn sort_inner_indexed<'a, 'gc, C>(
+    activation: &mut Activation<'a, 'gc>,
+    values: &mut [(usize, Value<'gc>)],
+    options: SortOptions,
+    mut sort_func: C,
+) -> Result<bool, Error<'gc>>
+where
+    C: FnMut(&mut Activation<'a, 'gc>, (usize, Value<'gc>), (usize, Value<'gc>)) -> Result<Ordering, Error<'gc>>,
+{
+    let mut unique_sort_satisfied = true;
+
+    qsort(values, &mut |(ia, a), (ib, b)| {
+        let unresolved_a = *a;
+        let unresolved_b = *b;
+
+        if matches!(unresolved_a, Value::Undefined) && matches!(unresolved_b, Value::Undefined) {
+            unique_sort_satisfied = false;
+            return Ok(Ordering::Equal);
+        } else if matches!(unresolved_a, Value::Undefined) {
+            return Ok(Ordering::Greater);
+        } else if matches!(unresolved_b, Value::Undefined) {
+            return Ok(Ordering::Less);
+        }
+
+        sort_func(activation, (*ia, *a), (*ib, *b)).map(|cmp| {
+            if cmp == Ordering::Equal {
+                unique_sort_satisfied = false;
+                Ordering::Equal
+            } else if options.contains(SortOptions::DESCENDING) {
+                cmp.reverse()
+            } else {
+                cmp
+            }
+        })
+    })?;
+
+    Ok(!options.contains(SortOptions::UNIQUE_SORT) || unique_sort_satisfied)
+}

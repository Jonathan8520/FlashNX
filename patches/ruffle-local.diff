@@ -0,0 +1,27 @@
+package {
+    import flash.display.MovieClip;
+
+    // Only used by the "scripted" variant. Stands in for the point where Raze 2
+    // builds its menu: a frame script that constructs the sprite and adds it to
+    // the display list only once the constructor has returned.
+    public class Launcher extends MovieClip {
+
+        private var built:Boolean = false;
+
+        public function Launcher() {
+            super();
+            addFrameScript(0, onFrame);
+        }
+
+        private function onFrame():void {
+            if (built) {
+                return;
+            }
+            built = true;
+            trace("Launcher: frame script, constructing Menu");
+            var menu:Menu = new Menu();
+            addChild(menu);
+            trace("Launcher: frame script, Menu added to the display list");
+        }
+    }
+}

+#[cfg(test)]
+mod flashnx_tests {
+    use super::*;
+
+    /// `turbulence_channels` against `turbulence`, bit for bit, over seeds,
+    /// sizes, frequencies (zero, below and above one), octave counts, offsets,
+    /// stitching and fractal sums, and every channel subset `perlin_noise` uses.
+    #[test]
+    fn turbulence_channels_matches_turbulence() {
+        let mut r: u64 = 0x9E37_79B9_7F4A_7C15;
+        let mut next = move || {
+            r ^= r << 13;
+            r ^= r >> 7;
+            r ^= r << 17;
+            r
+        };
+        let mut checked = 0u64;
+        for case in 0..600 {
+            let seed = (next() % 200_000) as i64 - 100_000;
+            let turb = Turbulence::from_seed(seed);
+            let w = (1 + next() % 400) as f64;
+            let h = (1 + next() % 400) as f64;
+            let mut base = || match next() % 6 {
+                0 => 0.0,
+                1 => 1.0,
+                2 => w,
+                3 => (next() % 100_000) as f64 / 1000.0,
+                4 => 0.37,
+                _ => (next() % 900) as f64 + 0.5,
+            };
+            let (bx, by) = (base(), base());
+            let base_freq = (
+                if bx == 0.0 { 0.0 } else { 1.0 / bx },
+                if by == 0.0 { 0.0 } else { 1.0 / by },
+            );
+            let octaves = (next() % 11) as usize;
+            let stitch = next() % 2 == 0;
+            let fractal = next() % 2 == 0;
+            let offsets: Vec<(f64, f64)> = (0..octaves)
+                .map(|_| {
+                    (
+                        (next() % 2_000_000) as f64 / 1000.0 - 1000.0,
+                        (next() % 2_000_000) as f64 / 1000.0 - 1000.0,
+                    )
+                })
+                .collect();
+            let n = 1 + (case % 4);
+            let channels: Vec<usize> = (0..n).collect();
+            let setup = TurbulenceSetup::new(base_freq, stitch, (0.0, 0.0), (w, h));
+            for _ in 0..40 {
+                let p = ((next() % w as u64) as f64, (next() % h as u64) as f64);
+                let mut out = [0.0; 4];
+                turb.turbulence_channels(&channels, p, &setup, octaves, fractal, &offsets, &mut out);
+                for (k, &c) in channels.iter().enumerate() {
+                    let want = turb.turbulence(
+                        c, p, base_freq, octaves, fractal, stitch, (0.0, 0.0), (w, h), &offsets,
+                    );
+                    assert_eq!(
+                        want.to_bits(),
+                        out[k].to_bits(),
+                        "case {case} channel {c} point {p:?}: {want} vs {}",
+                        out[k]
+                    );
+                    checked += 1;
+                }
+            }
+        }
+        assert!(checked > 50_000);
+    }
 }

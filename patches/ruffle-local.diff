+/// every link up to the root, then the root's level. Reads names, allocates
+/// nothing. Two different paths colliding on 64 bits is not a realistic risk.
+fn flashnx_path_signature(object: DisplayObject<'_>) -> u64 {
+    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
+    let mut mix = |v: u64| {
+        h ^= v;
+        h = h.wrapping_mul(0x0000_0100_0000_01b3);
+    };
+    let mut current = object;
+    loop {
+        match current.avm1_parent() {
+            Some(parent) => {
+                match current.name() {
+                    Some(name) => {
+                        // Length first, so "ab"+"c" and "a"+"bc" differ.
+                        mix(name.len() as u64 + 1);
+                        for unit in name.iter() {
+                            mix(unit as u64);
+                        }
+                    }
+                    None => mix(0),
+                }
+                current = parent;
+            }
+            None => {
+                mix(0xFFFF_0000_0000 | (current.depth() as u32 as u64));
+                break;
+            }
+        }
+    }

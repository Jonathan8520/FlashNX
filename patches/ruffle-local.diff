+// ── CPU BitmapData memory accounting (FlashNX) ────────────────────────────────
+//
+// Ruffle keeps every BitmapData's pixels in a CPU-side Vec. A cutscene-heavy game
+// can allocate hundreds of large surfaces and OOM-abort the whole process. We
+// track live bytes here so the AVM1 constructor can refuse new surfaces past a
+// budget (returning `undefined`, which AS2 code handles) instead of letting the
+// process OOM-abort. Live, not cumulative: `MemGuard` subtracts on drop, including
+// on GC sweep.
+static BITMAPDATA_LIVE_BYTES: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+
+/// Ceiling for live CPU BitmapData bytes.
+pub const BITMAPDATA_BUDGET_BYTES: u64 = 384 * 1024 * 1024;
+
+/// Live CPU bytes currently held by BitmapData pixel buffers.
+pub fn bitmapdata_live_bytes() -> u64 {
+    BITMAPDATA_LIVE_BYTES.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+/// Only surfaces at least this big are ever refused. This floor is **load
+/// bearing** (see `BITMAPDATA_BUDGET_BYTES`): it MUST sit ABOVE the blit engine's
+/// working buffers, or refusing one freezes the game. Super Bowser World's screen
+/// buffer is 640x480 (~1.2 MB) and its ground strips are 1280x240 (~1.2 MB); a
+/// 1 MB floor caught those, refused them, and froze the engine into per-frame
+/// re-render (the 2 s freeze regression, hardware 2026-07-20). At 4 MB only the
+/// genuine 1824x1174 (~8.5 MB) "monsters" are refused - bounding the cutscene CPU
+/// flood without ever touching a working buffer. Ground-strip memory is bounded
+/// on the GPU side instead (`DroppedBitmap`), which never freezes because it keeps
+/// a valid handle and Ruffle's CPU pixels stay intact for collision.
+const BITMAPDATA_LARGE_SURFACE_BYTES: u64 = 4 * 1024 * 1024;
+
+/// True when allocating a `width x height` BitmapData now would push live CPU
+/// bytes past [`BITMAPDATA_BUDGET_BYTES`] - but only for individually large
+/// surfaces (see [`BITMAPDATA_LARGE_SURFACE_BYTES`]). The AVM1 constructor uses
+/// this to degrade gracefully (return `undefined`) instead of OOM-aborting.
+pub fn bitmapdata_would_exceed_budget(width: u32, height: u32) -> bool {
+    if BITMAPDATA_BUDGET_BYTES == 0 {
+        return false;
+    }
+    let want = width as u64 * height as u64 * 4;
+    // Never refuse a small surface - it can't be the OOM culprit, and refusing
+    // one risks breaking a game that needs it.
+    if want < BITMAPDATA_LARGE_SURFACE_BYTES {
+        return false;
+    }
+    BITMAPDATA_LIVE_BYTES
+        .load(std::sync::atomic::Ordering::Relaxed)
+        .saturating_add(want)
+        > BITMAPDATA_BUDGET_BYTES
+}
+
+/// True when live CPU BitmapData bytes are high enough that the incremental GC
+/// is likely to fall behind the allocation rate.
+///
+/// New Super Bowser World allocates ~1.2 MB ground strips in bursts and drops
+/// them again, so they ARE collectable — but `collect_debt()` only pays the
+/// incremental debt each frame, and hardware traces show the live total sawtoothing
+/// upward (259 -> 329 -> 349 -> 398 MB) until the heap refuses a 640x480 screen
+/// buffer. Those strips are 1.2 MB, i.e. BELOW `BITMAPDATA_LARGE_SURFACE_BYTES`,
+/// so the refusal guard can never catch them — and it must not, since the screen
+/// buffer it would also catch is exactly the same size. Forcing a full cycle when
+/// pressure is high flattens the peaks instead of refusing anything.
+pub fn bitmapdata_under_pressure() -> bool {
+    if BITMAPDATA_BUDGET_BYTES == 0 {
+        return false;
+    }
+    BITMAPDATA_LIVE_BYTES.load(std::sync::atomic::Ordering::Relaxed)
+        > BITMAPDATA_BUDGET_BYTES / 2
+}
+
+/// Zero-cost lifetime guard for a `BitmapRawData`'s pixel allocation: adds its
+/// byte size to the live counter on creation and subtracts it on drop (including
+/// GC sweep, since it lives as a plain field of the gc-managed `BitmapRawData`).
+/// `BitmapRawData` is `#[collect(no_drop)]` - that only forbids a Drop on the
+/// struct itself; a field owning a Drop type (like the `Vec` already does) is
+/// fine.
+struct MemGuard(u64);
+impl MemGuard {
+    fn new(bytes: u64) -> Self {
+        BITMAPDATA_LIVE_BYTES.fetch_add(bytes, std::sync::atomic::Ordering::Relaxed);
+        MemGuard(bytes)
+    }
+}
+impl Drop for MemGuard {
+    fn drop(&mut self) {
+        BITMAPDATA_LIVE_BYTES.fetch_sub(self.0, std::sync::atomic::Ordering::Relaxed);
+    }
+}
+impl std::fmt::Debug for MemGuard {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "MemGuard({})", self.0)
+    }
+}

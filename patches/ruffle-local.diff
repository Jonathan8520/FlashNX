+/// FlashNX: called with the traits of every class as it loads
+/// (`Class::load_abc_traits`). Only the static side of a public `libgme` that
+/// has a `gme_new_emu` is changed: CrossBridge's facade.
+pub fn native_traits<'gc>(
+    class: Class<'gc>,
+    activation: &mut Activation<'_, 'gc>,
+    traits: &mut [Trait<'gc>],
+) {
+    if api().is_none() || !class.is_c_class() {
+        return;
+    }
+    let name = class.name();
+    if !name.namespace().is_public() || name.local_name().to_utf8_lossy() != "libgme$" {
+        return;
+    }
+    if !traits
+        .iter()
+        .any(|t| t.name().local_name().to_utf8_lossy() == "gme_new_emu")
+    {
+        return;
+    }
+    let mc = activation.gc();
+    let mut replaced = 0;
+    for t in traits.iter_mut() {
+        let Some(native) = native_for(&t.name().local_name().to_utf8_lossy()) else {
+            continue;
+        };
+        let method: Method<'gc> = match t.kind() {
+            TraitKind::Method { method, .. } | TraitKind::Getter { method, .. } => *method,
+            _ => continue,
+        };
+        if let Some(twin) = t.flashnx_with_method(method.flashnx_native_twin(mc, native)) {
+            *t = twin;
+            replaced += 1;
+        }
+    }
+    tracing::info!("gme: libgme runs natively, {replaced} functions of its CrossBridge facade replaced");
+}

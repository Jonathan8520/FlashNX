+/// What the inline fast paths assume about Ruffle's data, measured.
+#[derive(Clone, Default)]
+struct Layout {
+    /// `Value::Bool`: tag in byte 0, the bool in byte `bool_off`.
+    bool_ok: bool,
+    bool_tag: u8,
+    bool_off: usize,
+    /// First 8 bytes of a `Value::Bool` (the tag), when `bool_off` >= 8.
+    bool_word: u64,
+    /// `Value::Number`: tag in byte 0, the f64 at `num_off`; `Value::Integer`:
+    /// tag in byte 0, the i32 at `int_off`.
+    num_ok: bool,
+    num_tag: u8,
+    num_off: usize,
+    int_tag: u8,
+    int_off: usize,
+    /// First 8 bytes of a `Value::Integer` / `Value::Number` (the tag), for a
+    /// result written over an operand of another type (`words_ok`).
+    int_word: u64,
+    num_word: u64,
+    words_ok: bool,
+    /// `Value::Object`: tags of the object types checked so far, and where the
+    /// slots' pointer and length are from the `Gc` box pointer at byte 8.
+    obj_tags: Vec<u8>,
+    slots_ptr_off: usize,
+    slots_len_off: usize,
+    probes: u32,
+    obj_fail: &'static str,
+    /// Offset of `GcBoxHeader::tagged_vtable` from the box (its 2 low bits are
+    /// the GC color, 3 = black), measured on two fresh arrays.
+    header_ok: bool,
+    header_probed: bool,
+    vtable_word: usize,
+}
+
+/// The reasons `fast_call` counts (`State::slow_why`).
+const SLOW_WHY: [&str; 11] = [
+    "off", "receiver", "bound", "no method", "native", "rejected", "not compiled yet", "arguments",
+    "no body", "arity", "argument type",
+];
+
+static mut STATE: Option<State> = None;
+
+fn state() -> &'static mut State {
+    // Single-threaded: AVM2 only runs on the Ruffle worker.
+    unsafe {
+        let s = &mut *(&raw mut STATE);
+        s.get_or_insert_with(|| State {
+            init: 0,
+            init_rc: 0,
+            rw: std::ptr::null_mut(),
+            rx: std::ptr::null_mut(),
+            used: 0,
+            helpers: [0; 256],
+            compiled: 0,
+            rejected: 0,
+            reasons: FnvHashMap::default(),
+            deopts: 0,
+            deopt_ops: FnvHashMap::default(),
+            runs: 0,
+            calls_direct: 0,
+            calls_slow: 0,
+            dm_views: 0,
+            dm_refused: 0,
+            typed_ops: 0,
+            all_ops: 0,
+            typefails: 0,
+            typefail_ops: FnvHashMap::default(),
+            slow_why: [0; SLOW_WHY.len()],
+            slow_names: FnvHashMap::default(),
+            layout: Layout::default(),
+            map: Vec::new(),
+            infos: Vec::new(),
+            inl_sites: 0,
+            inl_methods: 0,
+            inl_hits: 0,
+            inl_misses: 0,
+            inl_refused: FnvHashMap::default(),
+            #[cfg(feature = "flashnx_instr")]
+            kind_names: FnvHashMap::default(),
+        })
+    }
+}
+
+fn op_name(op: &Op<'_>) -> String {
+    let full = format!("{op:?}");
+    let end = full.find([' ', '{', '(']).unwrap_or(full.len());
+    full[..end].to_string()
+}
+
+#[inline(always)]
+fn kind(op: &Op<'_>) -> usize {
+    core::intrinsics::discriminant_value(op) as usize
+}
+
+fn init(s: &mut State) {
+    if s.init != 0 {
+        return;
+    }
+    s.init = -1;
+    if std::mem::size_of::<Value<'static>>() != 16 {
+        s.init_rc = 0xBAD1;
+        return;
+    }
+    let (mut rw, mut rx) = (std::ptr::null_mut(), std::ptr::null_mut());
+    let rc = unsafe { flashnx_jit_init(CODE_SIZE, &mut rw, &mut rx) };
+    s.init_rc = rc;
+    if rc != 0 || rw.is_null() || rx.is_null() {
+        return;
+    }
+    s.rw = rw;
+    s.rx = rx;
+    fill_helpers(&mut s.helpers);
+    probe_bool(&mut s.layout);
+    probe_numbers(&mut s.layout);
+    s.init = 1;
+}
+
+fn bytes8(v: Value<'_>) -> [u8; 16] {
+    let w = bytes_of(v);
+    let mut b = [0u8; 16];
+    b[..8].copy_from_slice(&w[0].to_le_bytes());
+    b[8..].copy_from_slice(&w[1].to_le_bytes());
+    b
+}
+
+fn primitive_tags() -> [u8; 5] {
+    [
+        bytes8(Value::Undefined)[0],
+        bytes8(Value::Null)[0],
+        bytes8(Value::Integer(0))[0],
+        bytes8(Value::Number(0.0))[0],
+        bytes8(Value::Bool(false))[0],
+    ]
+}
+
+fn probe_bool(l: &mut Layout) {
+    // The bytes around a payload are padding, with whatever was there: only
+    // the candidate places of the bool are compared (on the Switch build and
+    // on the PC alike, Ruffle's `Value` keeps every payload at byte 8).
+    let f = bytes8(Value::Bool(false));
+    let t = bytes8(Value::Bool(true));
+    let others = [bytes8(Value::Undefined)[0], bytes8(Value::Null)[0], bytes8(Value::Integer(0))[0], bytes8(Value::Number(0.0))[0]];
+    if f[0] != t[0] || others.contains(&f[0]) {
+        return;
+    }
+    let hits: Vec<usize> = [8usize, 1, 4].into_iter().filter(|&o| f[o] == 0 && t[o] == 1).collect();
+    if hits.len() != 1 {
+        return;
+    }
+    l.bool_tag = f[0];
+    l.bool_off = hits[0];
+    l.bool_ok = true;
+    // A bool written by the JIT: this word (the tag), then the byte.
+    l.bool_word = if l.bool_off >= 8 { f[0] as u64 } else { 0 };
+}
+
+fn probe_numbers(l: &mut Layout) {
+    let n = bytes8(Value::Number(1.5));
+    let i = bytes8(Value::Integer(0x1234_5678));
+    let others = [bytes8(Value::Undefined)[0], bytes8(Value::Null)[0], bytes8(Value::Bool(false))[0]];
+    if n[0] == i[0] || others.contains(&n[0]) || others.contains(&i[0]) {
+        return;
+    }
+    let bits = 1.5f64.to_bits().to_le_bytes();
+    let Some(num_off) = (8..=8).step_by(8).find(|&o| n[o..o + 8] == bits) else { return };
+    let ib = 0x1234_5678i32.to_le_bytes();
+    let Some(int_off) = (4..=12).step_by(4).find(|&o| i[o..o + 4] == ib) else { return };
+    l.num_tag = n[0];
+    l.num_off = num_off;
+    l.int_tag = i[0];
+    l.int_off = int_off;
+    l.int_word = bytes_of(Value::Integer(0))[0];
+    l.num_word = bytes_of(Value::Number(0.0))[0];
+    l.num_ok = l.bool_ok && l.bool_off >= 8;
+    // A tag word can only be written alone with the payloads past it.
+    l.words_ok = l.num_ok && num_off >= 8 && int_off >= 8;
+}
+
+/// Where the GC color lives in a box header: two fresh objects of the same
+/// type share their (tagged) vtable pointer, not their `next` pointer, and
+/// gc-arena links each new box in front of the previous one (`allocate`:
+/// `header.set_next(self.all)`), so the second one's `next` IS the first box.
+/// Anything else and `setslot` keeps its helper (and gc-arena's barrier).
+fn probe_header(l: &mut Layout, act: &mut Activation<'_, '_>) {
+    l.header_probed = true;
+    let a1 = ArrayObject::empty(act.context);
+    let a2 = ArrayObject::empty(act.context);
+    let b1 = bytes_of(Value::Object(a1.into()))[1] as usize;
+    let b2 = bytes_of(Value::Object(a2.into()))[1] as usize;
+    if b1 == 0 || b2 == 0 || b1 % 8 != 0 || b2 % 8 != 0 {
+        return;
+    }
+    let w = |b: usize, k: usize| unsafe { *((b + 8 * k) as *const usize) };
+    let mut hit = None;
+    for k in 0..2 {
+        let (x, y) = (w(b1, k) & !0xF, w(b2, k) & !0xF);
+        let other = 1 - k;
+        if x != 0 && x == y && w(b1, other) != w(b2, other) {
+            if hit.is_some() {
+                return;
+            }
+            hit = Some(k);
+        }
+    }
+    if let Some(k) = hit
+        && w(b2, 1 - k) == b1
+    {
+        l.vtable_word = 8 * k;
+        l.header_ok = true;
+    }
+}
+
+/// Learn the layout of one more type of object from a live one: Ruffle's own
+/// accessors (`gc_base`, the slots) against the raw bytes the JIT would read.
+fn probe_object(l: &mut Layout, v: Value<'_>) {
+    l.probes += 1;
+    let Value::Object(o) = v else { return };
+    let raw = bytes_of(v);
+    let tag = (raw[0] & 0xff) as u8;
+    if l.obj_tags.contains(&tag) {
+        return;
+    }
+    if primitive_tags().contains(&tag) {
+        l.obj_fail = "tag";
+        return;
+    }
+    if std::mem::size_of::<gc_arena::lock::Lock<Value<'static>>>() != 16 {
+        l.obj_fail = "slot size";
+        return;
+    }
+    let box_ptr = raw[1] as usize;
+    let base = o.gc_base();
+    let value = Gc::as_ptr(base) as usize;
+    if value < box_ptr || value - box_ptr > 64 {
+        l.obj_fail = "box";
+        return;
+    }
+    let (sp, sl) = base.flashnx_slots();
+    if sl == 0 || sp == sl {
+        return; // cannot tell the pointer from the length on this one
+    }
+    let field = value - box_ptr + ScriptObjectData::FLASHNX_SLOTS_OFFSET;
+    let words = unsafe { *((box_ptr + field) as *const [usize; 2]) };
+    let (ptr_off, len_off) = if words == [sp, sl] {
+        (field, field + 8)
+    } else if words == [sl, sp] {
+        (field + 8, field)
+    } else {
+        l.obj_fail = "slots";
+        return;
+    };
+    if ptr_off % 8 != 0 || ptr_off > 32000 {
+        l.obj_fail = "offset";
+        return;
+    }
+    if !l.obj_tags.is_empty() && (l.slots_ptr_off != ptr_off || l.slots_len_off != len_off) {
+        l.obj_fail = "mismatch";
+        return;
+    }
+    l.slots_ptr_off = ptr_off;
+    l.slots_len_off = len_off;
+    if l.obj_tags.len() < 4 {
+        l.obj_tags.push(tag);
+    }
+}
+
+// ---------------------------------------------------------------- assembler
+
+#[derive(Clone, Copy)]
+enum Target {
+    Op(usize),
+    Exit,
+    /// An instruction index of this method's code.
+    Code(usize),
+}
+
+#[derive(Clone, Copy)]
+enum Fix {
+    B,
+    /// cbz (false) / cbnz (true) on w<rt>.
+    Cb(bool, u32),
+    BCond(u32),
+}
+
+const EQ: u32 = 0;
+const NE: u32 = 1;
+const MI: u32 = 4;
+const PL: u32 = 5;
+const VS: u32 = 6;
+const HI: u32 = 8;
+const LS: u32 = 9;
+const GE: u32 = 10;
+const LT: u32 = 11;
+const GT: u32 = 12;
+const LE: u32 = 13;
+
+struct Asm {
+    code: Vec<u32>,
+    fixups: Vec<(usize, Target, Fix)>,
+}
+
+// Register-offset loads and stores (`mem_reg`): ldrb / ldrh / ldr w / ldr s /
+// ldr d, then the stores, of `[xn, xm]`.
+const MEM_LDRB: u32 = 0x3860_6800;
+const MEM_LDRH: u32 = 0x7860_6800;
+const MEM_LDR_W: u32 = 0xB860_6800;
+const MEM_LDR_S: u32 = 0xBC60_6800;
+const MEM_LDR_D: u32 = 0xFC60_6800;
+const MEM_STRB: u32 = 0x3820_6800;
+const MEM_STRH: u32 = 0x7820_6800;
+const MEM_STR_W: u32 = 0xB820_6800;
+const MEM_STR_S: u32 = 0xBC20_6800;
+const MEM_STR_D: u32 = 0xFC20_6800;
+
+const X0: u32 = 0;
+const X16: u32 = 16;
+const X19: u32 = 19;
+const X20: u32 = 20;
+const X21: u32 = 21;
+const XZR: u32 = 31;
+const SP: u32 = 31;
+
+impl Asm {
+    fn e(&mut self, i: u32) {
+        self.code.push(i);
+    }
+    /// ldr q<rt>, [x<rn>, #off] (off multiple of 16, < 65536)
+    fn ldr_q(&mut self, rt: u32, rn: u32, off: usize) {
+        self.e(0x3DC0_0000 | ((off / 16) as u32) << 10 | rn << 5 | rt);
+    }
+    /// str q<rt>, [x<rn>, #off]
+    fn str_q(&mut self, rt: u32, rn: u32, off: usize) {
+        self.e(0x3D80_0000 | ((off / 16) as u32) << 10 | rn << 5 | rt);
+    }
+    /// str x<rt>, [x<rn>, #off] (off multiple of 8, < 32768)
+    fn str_x(&mut self, rt: u32, rn: u32, off: usize) {
+        self.e(0xF900_0000 | ((off / 8) as u32) << 10 | rn << 5 | rt);
+    }
+    /// ldr x<rt>, [x<rn>, #off]
+    fn ldr_x(&mut self, rt: u32, rn: u32, off: usize) {
+        self.e(0xF940_0000 | ((off / 8) as u32) << 10 | rn << 5 | rt);
+    }
+    /// ldrb w<rt>, [x<rn>, #off] (off < 4096)
+    fn ldrb(&mut self, rt: u32, rn: u32, off: usize) {
+        self.e(0x3940_0000 | (off as u32) << 10 | rn << 5 | rt);
+    }
+    /// cmp w<rn>, #imm (imm < 4096)
+    fn cmp_w(&mut self, rn: u32, imm: u32) {
+        self.e(0x7100_001F | imm << 10 | rn << 5);
+    }
+    /// cmp x<rn>, #imm (imm < 4096)
+    fn cmp_x(&mut self, rn: u32, imm: u32) {
+        self.e(0xF100_001F | imm << 10 | rn << 5);
+    }
+    /// ldr d<rt>, [x<rn>, #off] (off multiple of 8)
+    fn ldr_d(&mut self, rt: u32, rn: u32, off: usize) {
+        self.e(0xFD40_0000 | ((off / 8) as u32) << 10 | rn << 5 | rt);
+    }
+    fn str_d(&mut self, rt: u32, rn: u32, off: usize) {
+        self.e(0xFD00_0000 | ((off / 8) as u32) << 10 | rn << 5 | rt);
+    }
+    /// ldr w<rt>, [x<rn>, #off] (off multiple of 4)
+    fn ldr_w(&mut self, rt: u32, rn: u32, off: usize) {
+        self.e(0xB940_0000 | ((off / 4) as u32) << 10 | rn << 5 | rt);
+    }
+    fn str_w(&mut self, rt: u32, rn: u32, off: usize) {
+        self.e(0xB900_0000 | ((off / 4) as u32) << 10 | rn << 5 | rt);
+    }
+    /// strb w<rt>, [x<rn>, #off] (off < 4096)
+    fn strb(&mut self, rt: u32, rn: u32, off: usize) {
+        self.e(0x3900_0000 | (off as u32) << 10 | rn << 5 | rt);
+    }
+    /// cset w<rd>, cond
+    fn cset(&mut self, rd: u32, cond: u32) {
+        self.e(0x1A9F_07E0 | (cond ^ 1) << 12 | rd);
+    }
+    /// cmp x<rn>, x<rm>
+    fn cmp_xx(&mut self, rn: u32, rm: u32) {
+        self.e(0xEB00_001F | rm << 16 | rn << 5);
+    }
+    /// add x<rd>, x<rn>, #imm (imm < 4096)
+    fn add_xi(&mut self, rd: u32, rn: u32, imm: u32) {
+        self.e(0x9100_0000 | imm << 10 | rn << 5 | rd);
+    }
+    /// w<rd> = v, in one or two instructions.
+    fn mov_w(&mut self, rd: u32, v: i32) {
+        let u = v as u32;
+        if u >> 16 == 0 {
+            self.e(0x5280_0000 | u << 5 | rd); // movz
+        } else if !u >> 16 == 0 {
+            self.e(0x1280_0000 | (!u) << 5 | rd); // movn
+        } else {
+            self.e(0x5280_0000 | (u & 0xFFFF) << 5 | rd);
+            self.e(0x72A0_0000 | (u >> 16) << 5 | rd); // movk, lsl #16
+        }
+    }
+    /// w<rd> = w<rn> + c (|c| < 4096)
+    fn add_wi(&mut self, rd: u32, rn: u32, c: i32) {
+        if c >= 0 {
+            self.e(0x1100_0000 | (c as u32) << 10 | rn << 5 | rd);
+        } else {
+            self.e(0x5100_0000 | (c.unsigned_abs()) << 10 | rn << 5 | rd);
+        }
+    }
+    /// cmp w<rn>, #c, through w<tmp> when c needs more than 12 bits.
+    fn cmp_wi(&mut self, rn: u32, c: i32, tmp: u32) {
+        if (0..4096).contains(&c) {
+            self.cmp_w(rn, c as u32);
+        } else if (-4095..0).contains(&c) {
+            self.e(0x3100_001F | c.unsigned_abs() << 10 | rn << 5); // cmn
+        } else {
+            self.mov_w(tmp, c);
+            self.e(0x6B00_001F | tmp << 16 | rn << 5);
+        }
+    }
+    /// Every backward branch: the script time limit and the pause, through
+    /// `h_timeout` once in `POLL_EVERY` times. A helper call on every one was
+    /// ~2.5 % of Super Mario Bros. Crossover's startup (CrossBridge loops).
+    fn poll_timeout(&mut self) {
+        self.ldr_w(9, X21, CTX_POLL);
+        self.e(0x7100_0529); // subs w9, w9, #1
+        self.str_w(9, X21, CTX_POLL);
+        let skip = self.fwd(Fix::BCond(PL));
+        self.call(H_TIMEOUT, 0, 0, 0, true);
+        let here = self.here();
+        self.set(skip, here);
+    }
+    /// A load or store `<op> <rt>, [x<rn>, x<rm>]`, `op` one of the `MEM_*`.
+    fn mem_reg(&mut self, op: u32, rt: u32, rn: u32, rm: u32) {
+        self.e(op | rm << 16 | rn << 5 | rt);
+    }
+    fn here(&self) -> usize {
+        self.code.len()
+    }
+    /// A branch whose target is set later with `set`; returns its fixup.
+    fn fwd(&mut self, fix: Fix) -> usize {
+        self.branch(fix, Target::Code(usize::MAX));
+        self.fixups.len() - 1
+    }
+    fn set(&mut self, fixup: usize, to: usize) {
+        self.fixups[fixup].1 = Target::Code(to);
+    }
+    /// movz w<rd>, #imm16
+    fn movz_w(&mut self, rd: u32, imm: u32) {
+        self.e(0x5280_0000 | (imm & 0xFFFF) << 5 | rd);
+    }
+    /// x<rd> = v; returns the register holding v (xzr for 0).
+    fn mov_x(&mut self, rd: u32, v: u64) -> u32 {
+        if v == 0 {
+            return XZR;
+        }
+        let mut first = true;
+        for hw in 0..4u32 {
+            let part = ((v >> (hw * 16)) & 0xFFFF) as u32;
+            if part == 0 {
+                continue;
+            }
+            let base = if first { 0xD280_0000 } else { 0xF280_0000 };
+            self.e(base | hw << 21 | part << 5 | rd);
+            first = false;
+        }
+        rd
+    }
+    /// Store the 16 bytes `v` at [x19 + off].
+    fn store_const(&mut self, off: usize, v: [u64; 2]) {
+        let r0 = self.mov_x(0, v[0]);
+        let r1 = self.mov_x(1, v[1]);
+        self.str_x(r0, X19, off);
+        self.str_x(r1, X19, off + 8);
+    }
+    fn branch(&mut self, fix: Fix, t: Target) {
+        self.fixups.push((self.code.len(), t, fix));
+        self.e(match fix {
+            Fix::B => 0x1400_0000,
+            Fix::Cb(false, rt) => 0x3400_0000 | rt,
+            Fix::Cb(true, rt) => 0x3500_0000 | rt,
+            Fix::BCond(cond) => 0x5400_0000 | cond,
+        });
+    }
+    /// x0 = ctx, w1..w3 = args, call helpers[h]; on a non-zero status, leave.
+    fn call(&mut self, h: usize, a1: usize, a2: usize, a3: usize, exit_on_status: bool) {
+        self.e(0xAA00_03E0 | X21 << 16 | X0); // mov x0, x21
+        self.movz_w(1, a1 as u32);
+        self.movz_w(2, a2 as u32);
+        self.movz_w(3, a3 as u32);
+        self.ldr_x(X16, X20, h * 8);
+        self.e(0xD63F_0000 | X16 << 5); // blr x16
+        if exit_on_status {
+            self.branch(Fix::Cb(true, 0), Target::Exit);
+        }
+    }
+    /// The frame: x29, x30, x19, x20, x21, then the registers of `POOL`
+    /// (`pool_save`), saved by the room `emit` leaves after this.
+    fn prologue(&mut self) {
+        self.e(0xA9BA_7BFD); // stp x29, x30, [sp, #-96]!
+        self.e(0x9100_03FD); // mov x29, sp
+        self.e(0xA901_53F3); // stp x19, x20, [sp, #16]
+        self.str_x(X21, SP, 32);
+        self.e(0xAA00_03E0 | X0 << 16 | X21); // mov x21, x0
+        self.ldr_x(X19, X0, 0);
+        self.ldr_x(X20, X0, 8);
+    }
+    fn epilogue(&mut self, pool: &[u32]) {
+        for &r in pool {
+            self.ldr_x(r, SP, pool_save(r));
+        }
+        self.ldr_x(X21, SP, 32);
+        self.e(0xA941_53F3); // ldp x19, x20, [sp, #16]
+        self.e(0xA8C6_7BFD); // ldp x29, x30, [sp], #96
+        self.e(0xD65F_03C0); // ret
+    }
+    fn resolve(&mut self, labels: &[usize], exit: usize) -> bool {
+        for &(at, t, fix) in &self.fixups {
+            let to = match t {
+                Target::Op(i) => match labels.get(i) {
+                    Some(&l) if l != usize::MAX => l,
+                    _ => return false,
+                },
+                Target::Exit => exit,
+                Target::Code(c) if c != usize::MAX => c,
+                Target::Code(_) => return false,
+            };
+            let delta = to as i64 - at as i64;
+            // A branch that does not reach is a method that cannot be compiled,
+            // never a truncated offset: `cbz`/`cbnz`/`b.cond` reach +-1 MB and
+            // `b` +-128 MB, and the masks below would silently wrap. Every
+            // helper call is followed by `cbnz w0, <exit>`, which jumps to the
+            // END of the method, so a method of more than 1 MB of code sent its
+            // first early return into whatever lay 1 MB away: haunt the house,
+            // loading a level, executed zeroed code memory (2026-10-08).
+            let (bits, ok) = match fix {
+                Fix::B => (26, (-(1i64 << 25)..(1i64 << 25)).contains(&delta)),
+                Fix::Cb(..) | Fix::BCond(_) => (19, (-(1i64 << 18)..(1i64 << 18)).contains(&delta)),
+            };
+            if !ok {
+                return false;
+            }
+            let field = (delta as u32) & ((1u32 << bits) - 1);
+            self.code[at] |= match fix {
+                Fix::B => field,
+                Fix::Cb(..) | Fix::BCond(_) => field << 5,
+            };
+        }
+        true
+    }
+}
+
+/// The 16 bytes of `v` as the interpreter would store them in a stack slot.
+fn bytes_of(v: Value<'_>) -> [u64; 2] {
+    let mut buf = std::mem::MaybeUninit::<[u64; 2]>::zeroed();
+    unsafe {
+        (buf.as_mut_ptr() as *mut Value<'_>).write(v);
+        buf.assume_init()
+    }
+}
+
+fn lazy(m: &Gc<'_, Multiname<'_>>) -> usize {
+    m.has_lazy_name() as usize + m.has_lazy_ns() as usize
+}
+
+/// (values popped, values pushed). `None`: never compiled.
+fn effect(op: &Op<'_>) -> Option<(usize, usize)> {
+    use Op::*;
+    Some(match op {
+        PushDouble { .. } | PushFalse | PushInt { .. } | PushNamespace { .. } | PushNull
+        | PushString { .. } | PushTrue | PushUint { .. } | PushUndefined => (0, 1),
+        Pop => (1, 0),
+        Dup => (1, 2),
+        Swap => (2, 2),
+        GetLocal { .. } => (0, 1),
+        SetLocal { .. } => (1, 0),
+        StoreLocal { .. } => (1, 1),
+        Kill { .. } | IncLocal { .. } | IncLocalI { .. } | DecLocal { .. } | DecLocalI { .. } => (0, 0),
+        Call { num_args } => (2 + *num_args as usize, 1),
+        CallMethod { num_args, push_return_value, .. }
+        | CallNative { num_args, push_return_value, .. } => {
+            (1 + *num_args as usize, *push_return_value as usize)
+        }
+        CallProperty { multiname, num_args } | CallPropLex { multiname, num_args } => {
+            (1 + *num_args as usize + lazy(multiname), 1)
+        }
+        CallPropVoid { multiname, num_args } => (1 + *num_args as usize + lazy(multiname), 0),
+        CallStatic { num_args, .. } => (1 + *num_args as usize, 1),
+        CallSuper { multiname, num_args } => (1 + *num_args as usize + lazy(multiname), 1),
+        GetPropertyStatic { multiname } | GetPropertyFast { multiname } | GetPropertySlow { multiname } => {
+            (1 + lazy(multiname), 1)
+        }
+        SetPropertyStatic { multiname } | SetPropertyFast { multiname } | SetPropertySlow { multiname }
+        | InitProperty { multiname } => (2 + lazy(multiname), 0),
+        DeleteProperty { multiname } | GetSuper { multiname } | GetDescendants { multiname } => {
+            (1 + lazy(multiname), 1)
+        }
+        SetSuper { multiname } => (2 + lazy(multiname), 0),
+        FindProperty { multiname } | FindPropStrict { multiname } => (lazy(multiname), 1),
+        FindDef { .. } => (0, 1),
+        In | HasNext | NextName | NextValue | IsTypeLate | AsTypeLate | InstanceOf => (2, 1),
+        PushScope | PushWith | SetGlobalSlot { .. } | DxnsLate => (1, 0),
+        PopScope | Nop | Dxns { .. } | Debug { .. } | DebugFile { .. } | DebugLine { .. } | Bkpt
+        | BkptLine { .. } => (0, 0),
+        GetOuterScope { .. } | GetScopeObject { .. } | GetScriptGlobals { .. }
+        | NewActivation { .. } | NewFunction { .. } | HasNext2 { .. } => (0, 1),
+        GetSlot { .. } => (1, 1),
+        SetSlot { .. } | SetSlotCoerceI { .. } | SetSlotNoCoerce { .. } => (2, 0),
+        Construct { num_args } | ConstructSlot { num_args, .. } => (1 + *num_args as usize, 1),
+        ConstructProp { multiname, num_args } => (1 + *num_args as usize + lazy(multiname), 1),
+        ConstructSuper { num_args } => (1 + *num_args as usize, 0),
+        NewObject { num_args } => (2 * *num_args as usize, 1),
+        NewClass { .. } => (1, 1),
+        ApplyType { num_types } => (1 + *num_types as usize, 1),
+        NewArray { num_args } => (*num_args as usize, 1),
+        CoerceA | CoerceB | CoerceD | CoerceI | CoerceO | CoerceS | CoerceU | ConvertO | ConvertS
+        | Coerce { .. } | AsType { .. } | IsType { .. } | TypeOf | Not | Negate | NegateI | BitNot
+        | Increment | IncrementI | Decrement | DecrementI | EscXAttr | EscXElem | CheckFilter
+        | Lf32 | Lf64 | Li16 | Li32 | Li8 | Sxi1 | Sxi16 | Sxi8 => (1, 1),
+        CoerceDSwapPop | CoerceISwapPop | CoerceUSwapPop | CoerceSwapPop { .. } => (2, 1),
+        Add | AddI | BitAnd | BitOr | BitXor | Divide | LShift | Modulo | Multiply | MultiplyI
+        | RShift | Subtract | SubtractI | URShift | StrictEquals | Equals | GreaterEquals
+        | GreaterThan | LessEquals | LessThan => (2, 1),
+        Sf32 | Sf64 | Si16 | Si32 | Si8 => (2, 0),
+        Throw => (1, 0),
+        Jump { .. } => (0, 0),
+        IfTrue { .. } | IfFalse { .. } | PopJump { .. } | LookupSwitch(_) => (1, 0),
+        ReturnValue { .. } => (1, 0),
+        ReturnVoid { .. } => (0, 0),
+        Timestamp | NewCatch { .. } => return None,
+    })
+}
+
+// ---------------------------------------------------------------- compiler
+
+/// The stack depth before every reachable op (`u32::MAX`: unreachable) and
+/// the branch targets, or why the method cannot be compiled. `guards`: the
+/// `callmethod`s whose callee follows them (`splice`), and where the code
+/// goes on after it: the call's own effect only applies on the way there.
+fn shape(ops: &[Op<'_>], ms: usize, guards: &FnvHashMap<usize, usize>) -> Result<(Vec<u32>, Vec<bool>), String> {
+    let n = ops.len();
+    // Stack depth before every reachable op.
+    let mut depth = vec![u32::MAX; n];
+    depth[0] = 0;
+    let mut work = vec![0usize];
+    while let Some(i) = work.pop() {
+        let d = depth[i] as usize;
+        let op = &ops[i];
+        let (pops, pushes) = effect(op).ok_or_else(|| op_name(op))?;
+        if d < pops {
+            return Err("underflow".into());
+        }
+        let nd = d - pops + pushes;
+        if nd > ms {
+            return Err("overflow".into());
+        }
+        let succ: std::vec::Vec<(usize, usize)> = match op {
+            _ if guards.contains_key(&i) => std::vec![(i + 1, d), (guards[&i], nd)],
+            Op::Jump { offset } | Op::PopJump { offset } => std::vec![(*offset, nd)],
+            Op::IfTrue { offset } | Op::IfFalse { offset } => std::vec![(i + 1, nd), (*offset, nd)],
+            Op::LookupSwitch(ls) => {
+                // One compare per case, `cmp w0, #k`: 12 bits of k.
+                if ls.case_offsets.len() >= 4096 {
+                    return Err("switch size".into());
+                }
+                let mut t: std::vec::Vec<(usize, usize)> = ls.case_offsets.iter().map(|c| (c.get(), nd)).collect();
+                t.push((ls.default_offset.get(), nd));
+                t
+            }
+            Op::ReturnValue { .. } | Op::ReturnVoid { .. } | Op::Throw => std::vec::Vec::new(),
+            _ => std::vec![(i + 1, nd)],
+        };
+        for (t, td) in succ {
+            if t >= n {
+                return Err("falls off".into());
+            }
+            if depth[t] == u32::MAX {
+                depth[t] = td as u32;
+                work.push(t);
+            } else if depth[t] as usize != td {
+                return Err("depth merge".into());
+            }
+        }
+    }
+
+    // Branch targets: the stack cache is empty there (`Tos`). Both ways out
+    // of a guard are.
+    let mut target = vec![false; n];
+    for (&g, &cont) in guards {
+        if g + 1 < n {
+            target[g + 1] = true;
+        }
+        if cont < n {
+            target[cont] = true;
+        }
+    }
+    for op in ops.iter() {
+        if let Op::Jump { offset } | Op::PopJump { offset } | Op::IfTrue { offset } | Op::IfFalse { offset } = op
+            && *offset < n
+        {
+            target[*offset] = true;
+        }
+        if let Op::LookupSwitch(ls) = op {
+            for t in ls.case_offsets.iter().map(|c| c.get()).chain(std::iter::once(ls.default_offset.get())) {
+                if t < n {
+                    target[t] = true;
+                }
+            }
+        }
+    }
+    Ok((depth, target))
+}
+
+// ---------------------------------------------------------------- inlining
+//
+// Box2DFlash (Happy Wheels, Fireboy & Watergirl) makes ~25 000 calls a
+// frame, ~40 % of them to bodies of a few ops: `b2Math.b2Max`, `b2Min`,
+// `b2Bound.IsLower`, `b2Vec2.SetV`. A call through `fast_call` costs ~350 ns
+// on the console (what the vtable, the method, its body, its parameters and
+// a new `Activation` take to read and set up, 2026-10-29), where Flash
+// Player's is ~6 ns: those calls were ~18 % of a Happy Wheels frame.
+//
+// So a callee is copied into its caller, as JITs do (avmplus never did):
+// - Which method a `callmethod` calls is only known at run time. The
+//   interpreter notes it at each site while the caller is not compiled yet
+//   (`observe`, kept in the caller's `Method`, traced, so it outlives the
+//   code that compares against it). A site that saw two methods is a call.
+// - The copy runs behind a guard, the receiver's method at that vtable index
+//   (`h_guard`, ~20 ns): any other receiver makes the call, as before.
+// - The callee's locals are the caller's stack slots where the receiver and
+//   the arguments already are (its `this` and parameters, in place), its own
+//   stack goes on above them, and its ops address them as locals past the
+//   caller's (`GetLocal { nl + slot }`): the frame grows by what that takes
+//   (`flashnx_frame_extra`). Its returns put the value in the receiver's slot
+//   and jump to the op after the call.
+// - Only ops whose result does not depend on the activation they run in are
+//   copied (`copyable`): locals, constants, arithmetic, comparisons,
+//   coercions, slots, forward branches. Parameters and returns are coerced
+//   as `coerce_to_type` does, with the same ops the interpreter has. An error
+//   in a copy is thrown the same, from the caller.
+
+/// The interpreter is at `callmethod` op `site` of `method`: note which
+/// method its receiver has at `index`, while `method` is not compiled yet.
+#[inline(always)]
+pub(super) fn observe<'gc>(act: &Activation<'_, 'gc>, method: Method<'gc>, site: usize, index: usize, num_args: u32) {
+    if method.flashnx_jit().get() > 0xFFFF || !INLINE.load(AtomicOrdering::Relaxed) || !enabled() {
+        return;
+    }
+    observe_receiver(act, method, site, index, num_args);
+}
+
+#[inline(never)]
+fn observe_receiver<'gc>(act: &Activation<'_, 'gc>, method: Method<'gc>, site: usize, index: usize, num_args: u32) {
+    if let Value::Object(obj) = act.stack.peek(num_args as usize)
+        && let Some(full) = obj.vtable().get_full_method(index)
+    {
+        method.flashnx_observe(act.gc(), site as u32, full.method);
+    }
+}
+
+/// Whether some reachable-looking `callmethod` of `method` never ran yet:
+/// `run` keeps it interpreted a little longer so `observe` sees it.
+fn unseen_sites(method: Method<'_>) -> bool {
+    method
+        .get_verified_info()
+        .parsed_code
+        .iter()
+        .enumerate()
+        .any(|(i, op)| matches!(op, Op::CallMethod { .. }) && method.flashnx_site(i as u32).is_none())
+}
+
+/// Ops a copied callee may hold: their result does not depend on the
+/// activation running them (its scopes, its domain), and they never jump
+/// back. The calls among them run as calls (`h_call_method`, natives), their
+/// callees in their own activation; the script globals are the op's.
+fn copyable(op: &Op<'_>) -> bool {
+    use Op::*;
+    matches!(
+        op,
+        CallMethod { .. } | CallNative { .. } | GetScriptGlobals { .. } | GetPropertyStatic { .. }
+            | GetPropertyFast { .. } | SetPropertyStatic { .. } | SetPropertyFast { .. }
+            | GetLocal { .. } | SetLocal { .. } | StoreLocal { .. } | Kill { .. } | IncLocal { .. }
+            | IncLocalI { .. } | DecLocal { .. } | DecLocalI { .. } | PushDouble { .. } | PushFalse
+            | PushInt { .. } | PushNull | PushString { .. } | PushTrue | PushUint { .. } | PushUndefined
+            | Pop | Dup | Swap | Nop | Add | AddI | Subtract | SubtractI | Multiply | MultiplyI
+            | Divide | Modulo | Negate | NegateI | Increment | IncrementI | Decrement | DecrementI
+            | BitAnd | BitOr | BitXor | BitNot | LShift | RShift | URShift | Equals | StrictEquals
+            | LessThan | LessEquals | GreaterThan | GreaterEquals | Not | CoerceA | CoerceB | CoerceD
+            | CoerceI | CoerceU | CoerceS | Coerce { .. } | GetSlot { .. } | SetSlot { .. }
+            | SetSlotCoerceI { .. } | SetSlotNoCoerce { .. } | IfTrue { .. } | IfFalse { .. }
+            | Jump { .. } | ReturnValue { .. } | ReturnVoid { .. }
+    )
+}
+
+/// The op that coerces a value as `coerce_to_type(class)` does (a parameter
+/// on entry, a return value).
+fn coerce_op<'gc>(class: Class<'gc>) -> Op<'gc> {
+    if class.is_builtin_int() {
+        Op::CoerceI
+    } else if class.is_builtin_uint() {
+        Op::CoerceU
+    } else if class.is_builtin_number() {
+        Op::CoerceD
+    } else if class.is_builtin_boolean() {
+        Op::CoerceB
+    } else {
+        Op::Coerce { class }
+    }
+}
+
+/// A callee to copy at a `callmethod` (`splice`).
+struct CalleeCopy<'gc> {
+    /// The `callmethod`'s op index and argument count, and whether it keeps
+    /// the result.
+    at: usize,
+    n: usize,
+    push: bool,
+    /// The callee's ops, their stack depth (`shape`), its locals.
+    body: Vec<Op<'gc>>,
+    depth: Vec<u32>,
+    locals: usize,
+    /// How each parameter is coerced on entry (`None`: any type).
+    conv: Vec<Option<Op<'gc>>>,
+    /// What `h_guard` compares the receiver's method with.
+    expect: usize,
+}
+
+/// `callee` as a copy for a call with `n` arguments, or why not.
+/// The `bool`: a copy `INLINE_WIDE` covers.
+fn copy_of<'gc>(
+    callee: Method<'gc>,
+    n: usize,
+) -> Result<(Vec<Op<'gc>>, Vec<u32>, usize, Vec<Option<Op<'gc>>>, bool), String> {
+    let crate::avm2::method::MethodKind::Bytecode { verified_info } = callee.method_kind() else {
+        return Err("native".into());
+    };
+    let Some(info) = verified_info.get() else {
+        return Err("not verified".into());
+    };
+    if !info.exceptions.is_empty() {
+        return Err("try/catch".into());
+    }
+    if callee.needs_arguments_object() || callee.is_variadic() || callee.sets_dxns() {
+        return Err("arguments".into());
+    }
+    let body = callee.body().ok_or_else(|| "no body".to_string())?;
+    let ops = &info.parsed_code;
+    if ops.is_empty() || ops.len() > INLINE_MAX_OPS {
+        return Err("size".into());
+    }
+    let locals = body.num_locals as usize;
+    let signature = callee.resolved_param_config();
+    if signature.len() != n || locals < n + 1 {
+        return Err("arity".into());
+    }
+    let mut conv = Vec::with_capacity(n);
+    for param in signature.iter() {
+        conv.push(match param.param_type {
+            None => None,
+            Some(class) if class.is_builtin_void() => return Err("void".into()),
+            Some(class) => Some(coerce_op(class)),
+        });
+    }
+    for (k, op) in ops.iter().enumerate() {
+        if !copyable(op) {
+            return Err(format!("op {}", op_name(op)));
+        }
+        match op {
+            Op::IfTrue { offset } | Op::IfFalse { offset } | Op::Jump { offset }
+                if *offset <= k || *offset >= ops.len() =>
+            {
+                return Err("loop".into());
+            }
+            Op::ReturnValue { return_type: Some(class) } if class.is_builtin_void() => return Err("void".into()),
+            _ => {}
+        }
+    }
+    let (depth, _) = shape(ops, body.max_stack as usize, &FnvHashMap::default()).map_err(|_| "shape".to_string())?;
+    let wide = ops.len() > INLINE_FIRST_OPS
+        || ops.iter().any(|op| {
+            matches!(
+                op,
+                Op::CallMethod { .. } | Op::CallNative { .. } | Op::GetScriptGlobals { .. }
+                    | Op::GetPropertyStatic { .. } | Op::GetPropertyFast { .. } | Op::SetPropertyStatic { .. }
+                    | Op::SetPropertyFast { .. }
+            )
+        });
+    Ok((ops.to_vec(), depth, locals, conv, wide))
+}
+
+/// The callees `observe` saw at `method`'s `callmethod`s that can be copied.
+fn plan_inlines<'gc>(s: &mut State, method: Method<'gc>, ops: &[Op<'gc>], depth: &[u32]) -> Vec<CalleeCopy<'gc>> {
+    let mut out = Vec::new();
+    for (i, op) in ops.iter().enumerate() {
+        let Op::CallMethod { num_args, push_return_value, .. } = op else { continue };
+        if depth[i] == u32::MAX {
+            continue;
+        }
+        let Some(Some(callee)) = method.flashnx_site(i as u32) else { continue };
+        if callee == method {
+            continue;
+        }
+        let n = *num_args as usize;
+        match copy_of(callee, n) {
+            Ok((body, depth, locals, conv, wide)) => out.push(CalleeCopy {
+                at: i,
+                n,
+                push: *push_return_value,
+                body,
+                depth,
+                locals,
+                conv,
+                expect: callee.flashnx_key() | if wide { EXPECT_WIDE } else { 0 },
+            }),
+            Err(why) => *s.inl_refused.entry(why).or_insert(0) += 1,
+        }
+    }
+    out
+}
+
+/// `ops` with each copy's callee after its `callmethod`, which becomes its
+/// guard: the new op list, the method's op each comes from (`u32::MAX`: a
+/// callee's), each guard's way on after the call, and the callee each guard
+/// expects. `depth` and `nl` are the method's.
+///
+/// At a guard of depth `d`, the receiver is in stack slot `b = d - n - 1`, so
+/// callee local `k` is caller local `nl + b + k`: `this` and the parameters
+/// are already there. The callee's other locals are pushed as undefined
+/// (what a new frame holds), then its parameters coerced in place, then its
+/// ops run with their locals moved up by `nl + b`. A return leaves the value
+/// in slot `b` (`SetLocal`), drops the rest (`Pop` costs no code) and jumps
+/// on, as the call would have left the stack.
+fn splice<'gc>(
+    ops: &[Op<'gc>],
+    depth: &[u32],
+    nl: usize,
+    copies: &[CalleeCopy<'gc>],
+) -> (Vec<Op<'gc>>, Vec<u32>, FnvHashMap<usize, usize>, Vec<usize>) {
+    const NONE: u32 = u32::MAX;
+    let n = ops.len();
+    let mut out: Vec<Op<'gc>> = Vec::with_capacity(n * 2);
+    let mut orig: Vec<u32> = Vec::with_capacity(n * 2);
+    let mut new_at = vec![0usize; n + 1];
+    // Ops of `out` whose branch offset is still an index of `ops`, and the
+    // guards and returns that jump to the op after their call (by index of
+    // `ops` too).
+    let mut caller_branches = Vec::new();
+    let mut to_after: Vec<(usize, usize)> = Vec::new();
+    let mut guard_at: Vec<(usize, usize, usize)> = Vec::new();
+    let mut next = copies.iter().peekable();
+    for (i, op) in ops.iter().enumerate() {
+        new_at[i] = out.len();
+        let copy = match next.peek() {
+            Some(c) if c.at == i => next.next(),
+            _ => None,
+        };
+        let Some(c) = copy else {
+            if matches!(op, Op::Jump { .. } | Op::PopJump { .. } | Op::IfTrue { .. } | Op::IfFalse { .. }) {
+                caller_branches.push(out.len());
+            }
+            out.push(*op);
+            orig.push(i as u32);
+            continue;
+        };
+        let b = depth[i] as usize - c.n - 1;
+        let base = (nl + b) as u32;
+        guard_at.push((out.len(), i, c.expect as usize));
+        out.push(*op);
+        orig.push(i as u32);
+        macro_rules! push {
+            ($o:expr) => {{
+                out.push($o);
+                orig.push(NONE);
+            }};
+        }
+        for _ in c.n + 1..c.locals {
+            push!(Op::PushUndefined);
+        }
+        for (j, conv) in c.conv.iter().enumerate() {
+            if let Some(conv) = conv {
+                let index = base + 1 + j as u32;
+                push!(Op::GetLocal { index });
+                push!(*conv);
+                push!(Op::SetLocal { index });
+            }
+        }
+        // Where each callee op starts, and its branches to set once known.
+        let mut body_at = vec![0usize; c.body.len()];
+        let mut body_branches = Vec::new();
+        for (k, op) in c.body.iter().enumerate() {
+            body_at[k] = out.len();
+            if c.depth[k] == u32::MAX {
+                // Unreachable in the callee, so here: never run.
+                push!(Op::Nop);
+                continue;
+            }
+            // The callee's stack depth here, on top of its locals.
+            let r = c.depth[k] as usize;
+            match *op {
+                Op::GetLocal { index } => push!(Op::GetLocal { index: base + index }),
+                Op::SetLocal { index } => push!(Op::SetLocal { index: base + index }),
+                Op::StoreLocal { index } => push!(Op::StoreLocal { index: base + index }),
+                Op::Kill { index } => push!(Op::Kill { index: base + index }),
+                Op::IncLocal { index } => push!(Op::IncLocal { index: base + index }),
+                Op::IncLocalI { index } => push!(Op::IncLocalI { index: base + index }),
+                Op::DecLocal { index } => push!(Op::DecLocal { index: base + index }),
+                Op::DecLocalI { index } => push!(Op::DecLocalI { index: base + index }),
+                Op::IfTrue { .. } | Op::IfFalse { .. } | Op::Jump { .. } => {
+                    body_branches.push(out.len());
+                    push!(*op);
+                }
+                Op::ReturnValue { return_type } => {
+                    if let Some(class) = return_type {
+                        push!(coerce_op(class));
+                    }
+                    push!(Op::SetLocal { index: base });
+                    for _ in 0..c.locals + r - 1 - c.push as usize {
+                        push!(Op::Pop);
+                    }
+                    to_after.push((out.len(), i));
+                    push!(Op::Jump { offset: 0 });
+                }
+                Op::ReturnVoid { return_type } => {
+                    if c.push {
+                        push!(match return_type {
+                            Some(class) if class.is_builtin_numeric() => Op::PushInt { value: 0 },
+                            Some(class) if class.is_builtin_boolean() => Op::PushFalse,
+                            Some(class) if !class.is_builtin_void() => Op::PushNull,
+                            _ => Op::PushUndefined,
+                        });
+                        push!(Op::SetLocal { index: base });
+                    }
+                    for _ in 0..c.locals + r - c.push as usize {
+                        push!(Op::Pop);
+                    }
+                    to_after.push((out.len(), i));
+                    push!(Op::Jump { offset: 0 });
+                }
+                other => push!(other),
+            }
+        }
+        for at in body_branches {
+            let to = match &mut out[at] {
+                Op::IfTrue { offset } | Op::IfFalse { offset } | Op::Jump { offset } => offset,
+                _ => unreachable!(),
+            };
+            *to = body_at[*to];
+        }
+    }
+    new_at[n] = out.len();
+    for at in caller_branches {
+        match &mut out[at] {
+            Op::Jump { offset } | Op::PopJump { offset } | Op::IfTrue { offset } | Op::IfFalse { offset } => {
+                *offset = new_at[*offset];
+            }
+            _ => unreachable!(),
+        }
+    }
+    for (at, call) in to_after {
+        out[at] = Op::Jump { offset: new_at[call + 1] };
+    }
+    let mut guards = FnvHashMap::default();
+    let mut expect = vec![0usize; out.len()];
+    for (g, call, callee) in guard_at {
+        guards.insert(g, new_at[call + 1]);
+        expect[g] = callee;
+    }
+    (out, orig, guards, expect)
+}
+
+fn compile(s: &mut State, method: Method<'_>) -> Result<usize, String> {
+    init(s);
+    if s.init != 1 {
+        return Err("no code memory".into());
+    }
+    let info = method.get_verified_info();
+    if !info.exceptions.is_empty() {
+        return Err("try/catch".into());
+    }
+    let ops0 = &info.parsed_code;
+    let body = method.body().ok_or("no body")?;
+    let nl = body.num_locals as usize;
+    let ms = body.max_stack as usize;
+    if ops0.is_empty() || ops0.len() > 0xFFFF || nl + ms > 2000 {
+        return Err("size".into());
+    }
+
+    let none = FnvHashMap::default();
+    let (depth0, target0) = shape(ops0, ms, &none)?;
+    // The callees seen at its calls, copied in (`splice`). Not with a
+    // `lookupswitch`: its targets are in a `Gc` the interpreter shares.
+    let copies = if INLINE.load(AtomicOrdering::Relaxed)
+        && !ops0.iter().any(|op| matches!(op, Op::LookupSwitch(_)))
+    {
+        plan_inlines(s, method, ops0, &depth0)
+    } else {
+        Vec::new()
+    };
+    struct Spliced<'gc> {
+        ops: Vec<Op<'gc>>,
+        orig: Vec<u32>,
+        guards: FnvHashMap<usize, usize>,
+        expect: Vec<usize>,
+        depth: Vec<u32>,
+        target: Vec<bool>,
+        /// Stack slots it needs: its own and its copies'.
+        stack: usize,
+    }
+    let spliced = if copies.is_empty() {
+        None
+    } else {
+        let (ops, orig, guards, expect) = splice(ops0, &depth0, nl, &copies);
+        match shape(&ops, ms + INLINE_MAX_STACK, &guards) {
+            Ok((depth, target)) if ops.len() <= 0xFFFF => {
+                let top = depth.iter().filter(|&&d| d != u32::MAX).map(|&d| d as usize + 1).max().unwrap_or(0);
+                let stack = top.max(ms);
+                Some(Spliced { ops, orig, guards, expect, depth, target, stack })
+            }
+            Ok(_) => {
+                *s.inl_refused.entry("caller size".into()).or_insert(0) += 1;
+                None
+            }
+            Err(e) => {
+                *s.inl_refused.entry(format!("shape {e}")).or_insert(0) += 1;
+                None
+            }
+        }
+    };
+    let (ops, depth, target, guards, stack): (&[Op<'_>], &[u32], &[bool], &FnvHashMap<usize, usize>, usize) =
+        match &spliced {
+            Some(sp) => (&sp.ops, &sp.depth, &sp.target, &sp.guards, sp.stack),
+            None => (ops0, &depth0, &target0, &none, ms),
+        };
+    if nl + stack > 2000 {
+        return Err("size".into());
+    }
+    let lay = s.layout.clone();
+    let cache = TOS_CACHE.load(AtomicOrdering::Relaxed);
+    let cb = CROSSBRIDGE.load(AtomicOrdering::Relaxed);
+    let scopes = if cb { this_scopes(ops) } else { 0 };
+    // Ints out of their `Value`s (`Typer`): every frame offset within reach
+    // of `ldr w` (16 KB).
+    let typing = cb && INTS.load(AtomicOrdering::Relaxed) && lay.words_ok && (nl + stack) * 16 + 32 < 16384;
+    let mut entry = vec![Ty::Any; nl];
+    for (k, p) in method.resolved_param_config().iter().enumerate() {
+        if let (Some(class), Some(t)) = (p.param_type, entry.get_mut(k + 1)) {
+            *t = if class.is_builtin_int() {
+                Ty::Int
+            } else if class.is_builtin_number() {
+                Ty::Num
+            } else if class.is_builtin_boolean() {
+                Ty::Bool
+            } else {
+                Ty::Any
+            };
+        }
+    }
+    let types = if typing { analyze(ops, depth, target, &entry, guards) } else { None };
+    let check = CHECK.load(AtomicOrdering::Relaxed);
+    let (main, main_labels, main_exit, typed) =
+        emit(&lay, ops, depth, target, nl, cache, scopes, cb, types.as_ref(), check, guards)?;
+    s.typed_ops += typed;
+    s.all_ops += depth.iter().filter(|&&d| d != u32::MAX).count() as u64;
+    // The profiling build's A/B: the same method without its copied
+    // callees, as it compiled before them (`ALT`).
+    let alt = if DUAL.load(AtomicOrdering::Relaxed) && spliced.is_some() {
+        let types0 = if typing { analyze(ops0, &depth0, &target0, &entry, &none) } else { None };
+        let (code, labels, exit, _) =
+            emit(&lay, ops0, &depth0, &target0, nl, cache, scopes, cb, types0.as_ref(), check, &none)?;
+        Some((code, labels, exit))
+    } else {
+        None
+    };
+
+    // A 16-byte header (the address of the code `ALT` runs: the second
+    // compilation, or this one when there is none; then the `CodeInfo` of
+    // its copied callees, or null), the code, the other code.
+    let main_bytes = (main.len() * 4 + 15) & !15;
+    let alt_bytes = alt.as_ref().map_or(0, |a| a.0.len() * 4);
+    let total = 16 + main_bytes + alt_bytes;
+    if s.used + total > CODE_SIZE {
+        return Err("code memory full".into());
+    }
+    let addr = s.rx as usize + s.used + 16;
+    let alt_addr = if alt.is_some() { addr + main_bytes } else { addr };
+    let info: *const CodeInfo = match &spliced {
+        Some(sp) => {
+            s.inl_sites += copies.len() as u64;
+            s.inl_methods += 1;
+            // Frames of this method from now on have room for the copies;
+            // `run_compiled` interprets one taken before.
+            method.set_flashnx_frame_extra(sp.stack - ms);
+            let info = Box::new(CodeInfo {
+                // The ops' `Gc`s are the method's and its callees', which it
+                // keeps alive (`flashnx_sites`).
+                ops: unsafe { std::mem::transmute::<Vec<Op<'_>>, Vec<Op<'static>>>(sp.ops.clone()) },
+                orig: sp.orig.clone(),
+                expect: sp.expect.clone(),
+                frame: nl + sp.stack,
+            });
+            let p = &*info as *const CodeInfo;
+            s.infos.push(info);
+            p
+        }
+        None => std::ptr::null(),
+    };
+    unsafe {
+        let base = s.rw.add(s.used);
+        (base as *mut usize).write(alt_addr);
+        (base.add(8) as *mut usize).write(info as usize);
+        std::ptr::copy_nonoverlapping(main.as_ptr() as *const u8, base.add(16), main.len() * 4);
+        if let Some((code, _, _)) = &alt {
+            std::ptr::copy_nonoverlapping(code.as_ptr() as *const u8, base.add(16 + main_bytes), alt_bytes);
+        }
+        flashnx_jit_flush(base, s.rx.add(s.used), total);
+    }
+    s.used += (total + 15) & !15;
+    // The names `report` gives the helper counts under (`HELPER_N`).
+    #[cfg(feature = "flashnx_instr")]
+    for op in ops.iter() {
+        s.kind_names.entry(kind(op)).or_insert_with(|| op_name(op));
+    }
+    if MAP.load(AtomicOrdering::Relaxed) {
+        // The method's name too, on a line of its own that `jit_ops.py`
+        // skips (it reads `<address> <op>` pairs): `jit_methods.py` attributes
+        // the samples of compiled code to methods with it.
+        let mut name = crate::string::WString::new();
+        crate::avm2::function::display_function(&mut name, method);
+        let name = name.to_utf8_lossy().replace(char::is_whitespace, "_");
+        s.map.push((addr, format!("@ {name}")));
+        push_map(s, addr, ops, depth, &main_labels, main_exit);
+        if let Some((_, labels, exit)) = &alt {
+            s.map.push((alt_addr, format!("@ {name}")));
+            push_map(s, alt_addr, ops0, &depth0, labels, *exit);
+        }
+    }
+    Ok(addr)
+}
+
+/// How many of the method's own scopes are its `this`, so that
+/// `getscopeobject` below that index reads local 0. CrossBridge (FlasCC)
+/// functions start with `getlocal0, dup, pushscope, pushscope` and reach
+/// their globals (`ESP`, the functions they call) through those scopes: one
+/// helper per access otherwise, 30 million in Super Mario Bros. Crossover's
+/// sound recording. Upstream does the same in its optimizer (ruffle#24236).
+/// Only when the prologue holds the method's only scope ops and local 0 is
+/// never written.
+fn this_scopes(ops: &[Op<'_>]) -> usize {
+    let (n, prologue) = match ops {
+        [Op::GetLocal { index: 0 }, Op::PushScope, ..] => (1, 2),
+        [Op::GetLocal { index: 0 }, Op::Dup, Op::PushScope, Op::PushScope, ..] => (2, 4),
+        _ => return 0,
+    };
+    let writes_this = |op: &Op<'_>| match op {
+        Op::SetLocal { index }
+        | Op::StoreLocal { index }
+        | Op::Kill { index }
+        | Op::IncLocal { index }
+        | Op::IncLocalI { index }
+        | Op::DecLocal { index }
+        | Op::DecLocalI { index } => *index == 0,
+        Op::HasNext2 { object_register, index_register } => *object_register == 0 || *index_register == 0,
+        _ => false,
+    };
+    if ops[prologue..]
+        .iter()
+        .any(|op| matches!(op, Op::PushScope | Op::PushWith | Op::PopScope) || writes_this(op))
+    {
+        return 0;
+    }
+    n
+}
+
+// ---------------------------------------------------------------- int types
+
+/// What `analyze` proves of a value before running: always a
+/// `Value::Integer`, a `Value::Number`, a `Value::Bool`, or anything.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Ty {
+    Any,
+    Int,
+    Num,
+    Bool,
+}
+
+/// What `emit` knows of a method's ints to keep them out of their `Value`s
+/// (`V`), from `analyze`.
+struct Types {
+    /// The type of stack slot `k` before op `i`: `st[at[i] + k]`.
+    st: Vec<Ty>,
+    at: Vec<usize>,
+    /// The type of the local op `i` reads or writes, before it.
+    lt: Vec<Ty>,
+    /// `Add`, `Subtract`, `Multiply` or `URShift` whose result is only read
+    /// as `ToInt32` / `ToUint32` of it, in the same block: its 32 bits.
+    wrap: Vec<bool>,
+    /// The `Multiply` among them whose exact product can pass 2^53: their 32
+    /// bits are those of the double the interpreter rounds it to.
+    round: Vec<bool>,
+    /// A comparison of two ints read only by the next op, `IfTrue` /
+    /// `IfFalse`: one compare and one conditional branch.
+    fuse: Vec<bool>,
+}
+
+impl Types {
+    fn st(&self, i: usize, k: usize) -> Ty {
+        self.st[self.at[i] + k]
+    }
+}
+
+/// Bits of `|v|`: the least `b` with `|v| <= 2^b`.
+fn bits(v: i64) -> u32 {
+    let m = v.unsigned_abs();
+    if m <= 1 { 0 } else { 64 - (m - 1).leading_zeros() }
+}
+
+/// `ToInt32` or `ToUint32` is all op `op` takes of its operand `pos` (0: the
+/// top), so it reads an int's 32 bits the same as the exact value they wrap.
+fn int32_use(op: &Op<'_>, pos: u8) -> bool {
+    match op {
+        Op::CoerceI | Op::CoerceU | Op::CoerceISwapPop | Op::Sxi1 | Op::Sxi8 | Op::Sxi16 | Op::BitNot
+        | Op::IncrementI | Op::DecrementI | Op::NegateI | Op::Li8 | Op::Li16 | Op::Li32 | Op::Lf32
+        | Op::Lf64 | Op::Sf32 | Op::Sf64 | Op::SetSlotCoerceI { .. } => pos == 0,
+        Op::Si8 | Op::Si16 | Op::Si32 | Op::BitAnd | Op::BitOr | Op::BitXor | Op::LShift | Op::RShift
+        | Op::URShift | Op::AddI | Op::SubtractI | Op::MultiplyI => pos <= 1,
+        _ => false,
+    }
+}
+
+/// The types of `ops`' stack slots and locals (forward dataflow to a
+/// fixpoint, types meeting at branch targets), then the int operations that
+/// can work on 32 bits. `None`: nothing typed.
+///
+/// `Int` is a slot that holds a `Value::Integer` on every path: what an op
+/// that only pushes those pushed (`coerce_i`, `li16`, `sxi8`, bit operations,
+/// a constant), a local only ever set to one, a parameter declared `int`
+/// (`coerce_to_type`). `Add` of two ints is not one (it overflows to a
+/// Number), but `ToInt32` of it is their 32-bit sum: the exact sum of two
+/// ints is a double, and `ToInt32` takes it mod 2^32. This holds through any
+/// chain of `+ - *` whose exact values stay under 2^53, where every double
+/// the interpreter computes is exact (the bound of each value, `ib`, is kept
+/// in bits); past it only a product of two ints is taken, as the double it
+/// rounds to (`round`). This is how CrossBridge (FlasCC) code computes
+/// addresses and C ints: `add`, then `convert_i` or `li16`. Upstream's draft
+/// int interpreter (ruffle#23864) proves the same kinds of facts from its
+/// optimizer's types.
+fn analyze(
+    ops: &[Op<'_>],
+    depth: &[u32],
+    target: &[bool],
+    entry: &[Ty],
+    guards: &FnvHashMap<usize, usize>,
+) -> Option<Types> {
+    #[derive(Clone)]
+    struct S {
+        stack: Vec<Ty>,
+        locals: Vec<Ty>,
+    }
+    fn merge(into: &mut Option<S>, s: &S) -> bool {
+        let Some(t) = into else {
+            *into = Some(s.clone());
+            return true;
+        };
+        let mut changed = false;
+        for (x, y) in t.stack.iter_mut().zip(&s.stack).chain(t.locals.iter_mut().zip(&s.locals)) {
+            if *x != *y && *x != Ty::Any {
+                *x = Ty::Any;
+                changed = true;
+            }
+        }
+        changed
+    }
+    use Ty::*;
+    let n = ops.len();
+    let mut at = vec![0usize; n];
+    let mut total = 0;
+    for i in 0..n {
+        at[i] = total;
+        if depth[i] != u32::MAX {
+            total += depth[i] as usize;
+        }
+    }
+    let mut st = vec![Any; total];
+    let mut lt = vec![Any; n];
+    let mut entry_of: Vec<Option<S>> = vec![None; n];
+    // Passes over the code until no backward branch brings a new type.
+    loop {
+        let mut again = false;
+        let mut cur = Some(S { stack: Vec::new(), locals: entry.to_vec() });
+        for i in 0..n {
+            if depth[i] == u32::MAX {
+                cur = None;
+                continue;
+            }
+            if target[i] {
+                if let Some(c) = &cur {
+                    merge(&mut entry_of[i], c);
+                }
+                cur = entry_of[i].clone();
+            }
+            let Some(s) = cur.as_mut() else { continue };
+            let d = depth[i] as usize;
+            if s.stack.len() != d || s.locals.len() != entry.len() {
+                return None;
+            }
+            st[at[i]..at[i] + d].copy_from_slice(&s.stack);
+            let op = &ops[i];
+            let local = |s: &S, index: u32| s.locals.get(index as usize).copied().unwrap_or(Any);
+            if let Op::GetLocal { index } | Op::SetLocal { index } | Op::StoreLocal { index } = op {
+                lt[i] = local(s, *index);
+            }
+            let (pops, pushes) = effect(op)?;
+            if d < pops {
+                return None;
+            }
+            // A guard (`splice`): the call's result, of any type, where the
+            // code goes on; the copied callee next, the stack untouched.
+            if let Some(&cont) = guards.get(&i) {
+                let mut after = s.clone();
+                after.stack.truncate(d - pops);
+                after.stack.resize(d - pops + pushes, Any);
+                if cont < n && merge(&mut entry_of[cont], &after) && cont <= i {
+                    again = true;
+                }
+                continue;
+            }
+            let top = if d >= 1 { s.stack[d - 1] } else { Any };
+            let second = if d >= 2 { s.stack[d - 2] } else { Any };
+            let set = |s: &mut S, index: u32, t: Ty| {
+                if let Some(l) = s.locals.get_mut(index as usize) {
+                    *l = t;
+                }
+            };
+            match op {
+                Op::SetLocal { index } | Op::StoreLocal { index } => set(s, *index, top),
+                Op::Kill { index } | Op::IncLocal { index } | Op::DecLocal { index } => set(s, *index, Any),
+                Op::IncLocalI { index } | Op::DecLocalI { index } => set(s, *index, Int),
+                Op::HasNext2 { object_register, index_register } => {
+                    set(s, *object_register, Any);
+                    set(s, *index_register, Any);
+                }
+                _ => {}
+            }
+            let result = match op {
+                Op::GetLocal { index } => local(s, *index),
+                Op::Dup | Op::StoreLocal { .. } => top,
+                Op::PushInt { .. } | Op::CoerceI | Op::CoerceISwapPop | Op::Li8 | Op::Li16 | Op::Li32
+                | Op::Sxi1 | Op::Sxi8 | Op::Sxi16 | Op::BitAnd | Op::BitOr | Op::BitXor | Op::BitNot
+                | Op::LShift | Op::RShift | Op::IncrementI | Op::DecrementI | Op::NegateI | Op::AddI
+                | Op::SubtractI | Op::MultiplyI => Int,
+                Op::PushUint { value } => {
+                    if *value <= i32::MAX as u32 { Int } else { Num }
+                }
+                Op::PushDouble { .. } | Op::CoerceD | Op::CoerceDSwapPop | Op::Lf32 | Op::Lf64 | Op::Negate
+                | Op::Modulo => Num,
+                Op::PushTrue | Op::PushFalse | Op::CoerceB | Op::Not | Op::Equals | Op::StrictEquals
+                | Op::LessThan | Op::LessEquals | Op::GreaterThan | Op::GreaterEquals => Bool,
+                // Int + Int can overflow to a Number; anything else with a
+                // Number is a Number (op_add), strings and objects anything.
+                Op::Add => match (second, top) {
+                    (Int | Num, Int | Num) if second == Num || top == Num => Num,
+                    _ => Any,
+                },
+                // Two values that cannot both be ints: a Number.
+                Op::Subtract | Op::Multiply if matches!(second, Num | Bool) || matches!(top, Num | Bool) => Num,
+                _ => Any,
+            };
+            match op {
+                Op::Swap => s.stack.swap(d - 1, d - 2),
+                Op::Dup => s.stack.push(top),
+                _ => {
+                    s.stack.truncate(d - pops);
+                    for _ in 0..pushes {
+                        s.stack.push(result);
+                    }
+                }
+            }
+            let mut to = |t: usize, s: &S| {
+                if t < n && merge(&mut entry_of[t], s) && t <= i {
+                    again = true;
+                }
+            };
+            match op {
+                Op::IfTrue { offset } | Op::IfFalse { offset } | Op::Jump { offset } | Op::PopJump { offset } => {
+                    to(*offset, s)
+                }
+                Op::LookupSwitch(ls) => {
+                    for c in ls.case_offsets.iter() {
+                        to(c.get(), s);
+                    }
+                    to(ls.default_offset.get(), s);
+                }
+                _ => {}
+            }
+            if matches!(
+                op,
+                Op::Jump { .. } | Op::PopJump { .. } | Op::LookupSwitch(_) | Op::ReturnValue { .. }
+                    | Op::ReturnVoid { .. } | Op::Throw
+            ) {
+                cur = None;
+            }
+        }
+        if !again {
+            break;
+        }
+    }
+    let ty = |i: usize, k: usize| st[at[i] + k];
+
+    // Who reads each value pushed, in the same block (op, operand from the
+    // top), with the bound of the ints (`ib`, bits; NOT: not an int) and
+    // whether that int is only right mod 2^32 (`arith`: a `wrap` candidate).
+    const NONE: u32 = u32::MAX;
+    const NOT: u8 = u8::MAX;
+    let mut cons = vec![NONE; n];
+    let mut cpos = vec![0u8; n];
+    let mut ib = vec![NOT; n];
+    let mut arith = vec![false; n];
+    let mut leaves = vec![false; n];
+    let mut proper2 = vec![false; n];
+    let mut sim: Vec<u32> = Vec::new();
+    let mut fresh = true;
+    for i in 0..n {
+        if depth[i] == u32::MAX {
+            fresh = true;
+            continue;
+        }
+        let d = depth[i] as usize;
+        if fresh || target[i] || sim.len() != d {
+            sim.clear();
+            sim.resize(d, NONE);
+        }
+        fresh = false;
+        let op = &ops[i];
+        // Both ways out of a guard are branch targets: what it takes is read
+        // by nothing this pass follows.
+        if guards.contains_key(&i) {
+            fresh = true;
+            continue;
+        }
+        let (pops, pushes) = effect(op)?;
+        let (b, ar) = {
+            // Operand k (0: the top): (bits, a true int rather than 32 bits).
+            let operand = |k: usize| -> Option<(u32, bool)> {
+                let p = sim[d - 1 - k];
+                if p != NONE && ib[p as usize] != NOT {
+                    return Some((ib[p as usize] as u32, !arith[p as usize]));
+                }
+                (ty(i, d - 1 - k) == Int).then_some((31, true))
+            };
+            let konst = |k: usize| -> Option<i32> {
+                let p = sim[d - 1 - k];
+                match ops.get(p as usize) {
+                    Some(Op::PushInt { value }) => Some(*value),
+                    Some(Op::PushUint { value }) if *value <= i32::MAX as u32 => Some(*value as i32),
+                    _ => None,
+                }
+            };
+            if d >= 2 {
+                proper2[i] = matches!((operand(0), operand(1)), (Some((_, true)), Some((_, true))));
+            }
+            match op {
+                Op::PushInt { value } => (bits(*value as i64), false),
+                Op::PushUint { value } if *value <= i32::MAX as u32 => (bits(*value as i64), false),
+                Op::GetLocal { .. } if lt[i] == Int => (31, false),
+                Op::Li8 => (8, false),
+                Op::Li16 => (16, false),
+                Op::Sxi1 => (0, false),
+                Op::Sxi8 => (7, false),
+                Op::Sxi16 => (15, false),
+                Op::BitAnd => match (konst(0), konst(1)) {
+                    (Some(m), _) | (_, Some(m)) if m >= 0 => (bits(m as i64), false),
+                    _ => (31, false),
+                },
+                Op::CoerceI | Op::CoerceISwapPop | Op::Li32 | Op::BitOr | Op::BitXor | Op::BitNot | Op::LShift
+                | Op::RShift | Op::IncrementI | Op::DecrementI | Op::NegateI | Op::AddI | Op::SubtractI
+                | Op::MultiplyI => (31, false),
+                Op::Add | Op::Subtract => match (operand(1), operand(0)) {
+                    (Some((x, _)), Some((y, _))) => (x.max(y) + 1, true),
+                    _ => (NOT as u32, false),
+                },
+                Op::Multiply => match (operand(1), operand(0)) {
+                    (Some((x, px)), Some((y, py))) => {
+                        leaves[i] = px && py;
+                        (x + y, true)
+                    }
+                    _ => (NOT as u32, false),
+                },
+                // By 1 to 31: below 2^31, an int. By anything else, a uint.
+                Op::URShift => match (konst(0), operand(1), operand(0)) {
+                    (Some(c), Some(_), _) if c & 31 != 0 => (32 - (c & 31) as u32, false),
+                    (_, Some(_), Some(_)) => (32, true),
+                    _ => (NOT as u32, false),
+                },
+                _ => (NOT as u32, false),
+            }
+        };
+        for k in 0..pops {
+            let p = sim.pop().unwrap_or(NONE);
+            if p != NONE {
+                cons[p as usize] = i as u32;
+                cpos[p as usize] = k as u8;
+            }
+        }
+        match op {
+            // Copies: read by more than one op, or left where they were.
+            Op::Dup | Op::Swap | Op::StoreLocal { .. } => sim.resize(sim.len() + pushes, NONE),
+            _ if pushes == 1 => {
+                sim.push(i as u32);
+                if b < 254 {
+                    ib[i] = b as u8;
+                    arith[i] = ar;
+                }
+            }
+            _ => sim.resize(sim.len() + pushes, NONE),
+        }
+        if matches!(
+            op,
+            Op::IfTrue { .. } | Op::IfFalse { .. } | Op::Jump { .. } | Op::PopJump { .. } | Op::LookupSwitch(_)
+                | Op::ReturnValue { .. } | Op::ReturnVoid { .. } | Op::Throw
+        ) {
+            fresh = true;
+        }
+    }
+
+    // From the last op back, as readers come after what they read: 32 bits
+    // where the only reader takes `ToInt32` of them, or is itself on 32 bits.
+    let mut wrap = vec![false; n];
+    let mut round = vec![false; n];
+    for i in (0..n).rev() {
+        if !arith[i] || cons[i] == NONE {
+            continue;
+        }
+        let (b, j) = (ib[i] as u32, cons[i] as usize);
+        let direct = int32_use(&ops[j], cpos[i]);
+        if b <= 53 && (direct || (arith[j] && wrap[j] && !round[j])) {
+            wrap[i] = true;
+        } else if matches!(ops[i], Op::Multiply) && leaves[i] && direct {
+            wrap[i] = true;
+            round[i] = true;
+        }
+    }
+    let mut fuse = vec![false; n];
+    for i in 0..n.saturating_sub(1) {
+        fuse[i] = matches!(
+            ops[i],
+            Op::Equals | Op::StrictEquals | Op::LessThan | Op::LessEquals | Op::GreaterThan | Op::GreaterEquals
+        ) && cons[i] == (i + 1) as u32
+            && matches!(ops[i + 1], Op::IfTrue { .. } | Op::IfFalse { .. })
+            && !target[i + 1]
+            && proper2[i];
+    }
+    Some(Types { st, at, lt, wrap, round, fuse })
+}
+
+fn push_map(s: &mut State, addr: usize, ops: &[Op<'_>], depth: &[u32], labels: &[usize], exit: usize) {
+    s.map.push((addr, "(prologue)".into()));
+    for (i, op) in ops.iter().enumerate() {
+        if depth[i] != u32::MAX {
+            s.map.push((addr + labels[i] * 4, op_name(op)));
+        }
+    }
+    s.map.push((addr + exit * 4, "(epilogue)".into()));
+}
+
+/// FlashNX: where the top of the AVM2 operand stack is at the start of an op
+/// in compiled code: a one-entry stack cache, after the virtual stack of
+/// SpiderMonkey's baseline compiler (BaselineFrameInfo) and Ertl's stack
+/// caching. Without it every op wrote its result to the frame and the next op
+/// read it straight back; on Happy Wheels `GetLocal -> GetSlot` alone was 10 %
+/// of the frame and `GetSlot -> GetSlot` 6 %, much of it a load waiting on the
+/// store just before it.
+///
+/// Only the top entry is ever cached, and only between ops that know about
+/// it: every other op, every helper call, every branch and every branch
+/// target sees it written back first (`flush`), so the frame is exactly what
+/// the interpreter would hold wherever anything else can look at it. The
+/// registers only ever hold a value between two ops, where no collection can
+/// run.
+#[derive(Clone, Copy, PartialEq)]
+enum Tos {
+    /// In its frame slot.
+    Mem,
+    /// Not written yet: it is the local at this frame offset (`GetLocal`).
+    Local(usize),
+    /// Not written yet: its two words are in x14 (tag) and x15 (payload).
+    Regs,
+}
+
+/// Write the cached top of the stack to its frame slot at `at`.
+fn flush(a: &mut Asm, tos: Tos, at: usize) {
+    match tos {
+        Tos::Mem => {}
+        Tos::Local(off) => {
+            a.ldr_q(0, X19, off);
+            a.str_q(0, X19, at);
+        }
+        Tos::Regs => {
+            a.str_x(14, X19, at);
+            a.str_x(15, X19, at + 8);
+        }
+    }
+}
+
+/// FlashNX: where an operand stack entry is while `emit` keeps the ints of
+/// `Types` out of their `Value`s (`Typer`). Within a block only: branches,
+/// branch targets, untyped ops and helper calls find every entry written back
+/// to its frame slot, as the interpreter would hold it.
+#[derive(Clone, Copy, PartialEq)]
+enum V {
+    /// In its frame slot.
+    Mem,
+    /// In its frame slot, a `Value::Integer` (a `W` or `Imm` written back).
+    MemInt,
+    /// The local at this frame offset, not read yet (`GetLocal`), and
+    /// whether it is an int.
+    Local(usize, bool),
+    /// x14 / x15 (`Tos::Regs`, from the untyped `GetSlot`).
+    Regs,
+    /// This int.
+    Imm(i32),
+    /// The int in w<r>, one of `POOL`, its upper 32 bits clear. A `wrap`
+    /// result holds only the 32 bits `ToInt32` takes of it; written back, it
+    /// is that `Value::Integer`, which its only reader (`ToInt32` again, or
+    /// an op on 32 bits) reads the same.
+    W(u32),
+}
+
+/// The registers of `V::W`: callee-saved, so helper calls keep them; the
+/// prologue of a method saves those it uses.
+const POOL: std::ops::RangeInclusive<u32> = 22..=28;
+/// `nop`, the room left in the prologue for the saves of `POOL`.
+const NOP: u32 = 0xD503_201F;
+
+/// An int operand: in a register, or a constant.
+#[derive(Clone, Copy)]
+enum Src {
+    Reg(u32),
+    Imm(i32),
+}
+
+/// Typed code out of the way, after the method's code (`emit_cold`): none
+/// of it comes back but a successful `Refresh`. The entries to write back
+/// first are those of the moment the check was made (`save`).
+enum Cold {
+    /// The domain memory view is stale: `h_dm`, then back to `back`, or op
+    /// `i` in the interpreter.
+    Refresh { from: usize, back: usize, save: Vec<(usize, V)>, d: usize, i: usize },
+    /// An address out of range: the op's helper (which raises the
+    /// interpreter's error), then the interpreter from the next op.
+    Slow { from: Vec<usize>, save: Vec<(usize, V)>, helper: usize, d: usize, i: usize, post: usize },
+    /// `check`: no int where `analyze` proved one: counted, then op `i` in
+    /// the interpreter.
+    TypeFail { from: usize, save: Vec<(usize, V)>, d: usize, i: usize },
+}
+
+/// Write the entry `v` to the frame at `at` as the interpreter would hold it.
+fn store_v(a: &mut Asm, lay: &Layout, at: usize, v: V) {
+    match v {
+        V::Mem | V::MemInt => {}
+        V::Local(off, _) => {
+            a.ldr_q(0, X19, off);
+            a.str_q(0, X19, at);
+        }
+        V::Regs => {
+            a.str_x(14, X19, at);
+            a.str_x(15, X19, at + 8);
+        }
+        V::Imm(x) => a.store_const(at, bytes_of(Value::Integer(x))),
+        V::W(r) => {
+            let t = a.mov_x(9, lay.int_word);
+            a.str_x(t, X19, at);
+            a.str_w(r, X19, at + lay.int_off);
+        }
+    }
+}
+
+/// The interpreter's result of `op` on two int constants, as its readers
+/// take it (`ToInt32` for a `wrap` one).
+fn fold2(op: &Op<'_>, p: i32, q: i32) -> i32 {
+    match op {
+        Op::Add | Op::AddI => p.wrapping_add(q),
+        Op::Subtract | Op::SubtractI => p.wrapping_sub(q),
+        // The double product, rounded as the interpreter rounds it.
+        Op::Multiply => crate::ecma_conversions::f64_to_wrapping_i32(p as f64 * q as f64),
+        Op::MultiplyI => p.wrapping_mul(q),
+        Op::BitAnd => p & q,
+        Op::BitOr => p | q,
+        Op::BitXor => p ^ q,
+        Op::LShift => p.wrapping_shl(q as u32 & 31),
+        Op::RShift => p >> (q & 31),
+        _ => ((p as u32) >> (q as u32 & 31)) as i32, // URShift
+    }
+}
+
+/// w<rd> = `op` of two ints (`Typer::bin`).
+fn emit_bin(a: &mut Asm, op: &Op<'_>, rd: u32, x: Src, y: Src, round: bool) {
+    use Src::*;
+    match (op, x, y) {
+        (Op::LShift, Reg(n), Imm(c)) => {
+            let s = (c & 31) as u32;
+            return a.e(0x5300_0000 | ((32 - s) & 31) << 16 | (31 - s) << 10 | n << 5 | rd); // lsl
+        }
+        (Op::RShift, Reg(n), Imm(c)) => return a.e(0x1300_7C00 | ((c & 31) as u32) << 16 | n << 5 | rd), // asr
+        (Op::URShift, Reg(n), Imm(c)) => return a.e(0x5300_7C00 | ((c & 31) as u32) << 16 | n << 5 | rd), // lsr
+        (Op::Add | Op::AddI, Reg(n), Imm(c)) | (Op::Add | Op::AddI, Imm(c), Reg(n)) if c.unsigned_abs() < 4096 => {
+            return a.add_wi(rd, n, c);
+        }
+        (Op::Subtract | Op::SubtractI, Reg(n), Imm(c)) if c.unsigned_abs() < 4096 => return a.add_wi(rd, n, -c),
+        // On 32 bits, times 2^k is a shift.
+        (Op::Multiply | Op::MultiplyI, Reg(n), Imm(c)) | (Op::Multiply | Op::MultiplyI, Imm(c), Reg(n))
+            if !round && c > 0 && c.count_ones() == 1 =>
+        {
+            let s = c.trailing_zeros();
+            return a.e(0x5300_0000 | ((32 - s) & 31) << 16 | (31 - s) << 10 | n << 5 | rd);
+        }
+        _ => {}
+    }
+    let n = match x {
+        Reg(r) => r,
+        Imm(v) => {
+            a.mov_w(10, v);
+            10
+        }
+    };
+    let m = match y {
+        Reg(r) => r,
+        Imm(v) => {
+            a.mov_w(11, v);
+            11
+        }
+    };
+    let rr = m << 16 | n << 5 | rd;
+    match op {
+        Op::Add | Op::AddI => a.e(0x0B00_0000 | rr),
+        Op::Subtract | Op::SubtractI => a.e(0x4B00_0000 | rr),
+        Op::Multiply if round => {
+            // The exact product, rounded to a double as `n1 * n2` is, back
+            // to an integer (exact: it is one, under 2^62), its 32 bits.
+            a.e(0x9B20_7C00 | rr); // smull x<rd>, w<n>, w<m>
+            a.e(0x9E62_0000 | rd << 5); // scvtf d0, x<rd>
+            a.e(0x9E78_0000 | rd); // fcvtzs x<rd>, d0
+            a.e(0x2A00_03E0 | rd << 16 | rd); // mov w<rd>, w<rd>
+        }
+        Op::Multiply | Op::MultiplyI => a.e(0x1B00_7C00 | rr), // mul
+        Op::BitAnd => a.e(0x0A00_0000 | rr),
+        Op::BitOr => a.e(0x2A00_0000 | rr),
+        Op::BitXor => a.e(0x4A00_0000 | rr),
+        Op::LShift => a.e(0x1AC0_2000 | rr), // the count mod 32, as `& 0x1F`
+        Op::RShift => a.e(0x1AC0_2800 | rr),
+        _ => a.e(0x1AC0_2400 | rr), // URShift
+    }
+}
+
+/// The typed side of `emit`: an operand stack of `V`s for the ops whose
+/// operands `Types` proves to be ints, run on registers with no tag check,
+/// the others left to the untyped code with everything in the frame.
+struct Typer<'t> {
+    lay: &'t Layout,
+    ty: &'t Types,
+    nl: usize,
+    /// Check every int `analyze` proved where it is read from the frame
+    /// (`Cold::TypeFail`).
+    check: bool,
+    vs: Vec<V>,
+    cold: Vec<Cold>,
+    /// Bit r - 22 for each register of `POOL` used.
+    used: u32,
+    /// The domain memory view (`Ctx::dm_*`) was checked since the last
+    /// untyped op or branch target.
+    dm_ok: bool,
+    /// The next op (`IfTrue` / `IfFalse`) was emitted with this one.
+    skip: bool,
+    /// Ops emitted typed.
+    count: u64,
+}
+
+impl Typer<'_> {
+    fn slot(&self, k: usize) -> usize {
+        (self.nl + k) * 16
+    }
+
+    /// Write entry k back: it is in its frame slot from now on.
+    fn flush(&mut self, a: &mut Asm, k: usize) {
+        let v = self.vs[k];
+        store_v(a, self.lay, self.slot(k), v);
+        self.vs[k] = match v {
+            V::Imm(_) | V::W(_) | V::MemInt | V::Local(_, true) => V::MemInt,
+            _ => V::Mem,
+        };
+    }
+
+    /// The entries to write back on the way out (`Cold`).
+    fn snapshot(&self) -> Vec<(usize, V)> {
+        let mut s = Vec::new();
+        for (k, &v) in self.vs.iter().enumerate() {
+            if !matches!(v, V::Mem | V::MemInt) {
+                s.push((self.slot(k), v));
+            }
+        }
+        s
+    }
+
+    /// Entry k holds an int as op i finds it.
+    fn int(&self, i: usize, k: usize) -> bool {
+        match self.vs[k] {
+            V::Imm(_) | V::W(_) | V::MemInt => true,
+            V::Mem => self.ty.st(i, k) == Ty::Int,
+            V::Local(_, int) => int,
+            V::Regs => false,
+        }
+    }
+
+    /// `check`: the tag at `off` is `tag`, or `Cold::TypeFail`.
+    fn check_tag(&mut self, a: &mut Asm, i: usize, off: usize, tag: u8) {
+        if self.check && off < 4096 {
+            a.ldrb(9, X19, off);
+            a.cmp_w(9, tag as u32);
+            let from = a.fwd(Fix::BCond(NE));
+            let save = self.snapshot();
+            self.cold.push(Cold::TypeFail { from, save, d: self.vs.len(), i });
+        }
+    }
+
+    /// Entry k (an int, `int`) as a register or a constant; one in memory is
+    /// read into w<tmp>.
+    fn src(&mut self, a: &mut Asm, i: usize, k: usize, tmp: u32) -> Src {
+        let off = match self.vs[k] {
+            V::Imm(x) => return Src::Imm(x),
+            V::W(r) => return Src::Reg(r),
+            V::MemInt => {
+                a.ldr_w(tmp, X19, self.slot(k) + self.lay.int_off);
+                return Src::Reg(tmp);
+            }
+            V::Mem => self.slot(k),
+            V::Local(off, _) => off,
+            V::Regs => unreachable!(),
+        };
+        self.check_tag(a, i, off, self.lay.int_tag);
+        a.ldr_w(tmp, X19, off + self.lay.int_off);
+        Src::Reg(tmp)
+    }
+
+    /// `src` in a register.
+    fn reg(&mut self, a: &mut Asm, i: usize, k: usize, tmp: u32) -> u32 {
+        match self.src(a, i, k, tmp) {
+            Src::Reg(r) => r,
+            Src::Imm(v) => {
+                a.mov_w(tmp, v);
+                tmp
+            }
+        }
+    }
+
+    /// A register of `POOL` for a new `V::W`, writing the deepest one back
+    /// when all are taken.
+    fn alloc(&mut self, a: &mut Asm) -> u32 {
+        for r in POOL {
+            if !self.vs.contains(&V::W(r)) {
+                self.used |= 1 << (r - 22);
+                return r;
+            }
+        }
+        let k = self.vs.iter().position(|v| matches!(v, V::W(_))).unwrap();
+        let V::W(r) = self.vs[k] else { unreachable!() };
+        self.flush(a, k);
+        r
+    }
+
+    /// The domain memory view is valid from here on in this block: checked
+    /// once, refreshed out of the way (`Cold::Refresh`).
+    fn view(&mut self, a: &mut Asm, i: usize) {
+        if self.dm_ok {
+            return;
+        }
+        // `h_dm` does not keep x14 / x15 (the untyped `GetSlot`'s result).
+        if let Some(k) = self.vs.iter().position(|&v| v == V::Regs) {
+            self.flush(a, k);
+        }
+        a.ldr_x(9, X21, CTX_GEN);
+        a.ldr_x(9, 9, 0);
+        a.ldr_x(10, X21, CTX_DM_GEN);
+        a.cmp_xx(9, 10);
+        let from = a.fwd(Fix::BCond(NE));
+        let back = a.here();
+        let save = self.snapshot();
+        self.cold.push(Cold::Refresh { from, back, save, d: self.vs.len(), i });
+        self.dm_ok = true;
+    }
+
+    /// `w<addr> + width <= dm_len`, or `Cold::Slow` (`negative`: a store's
+    /// address, which must not be one).
+    fn bounds(&mut self, a: &mut Asm, op: &Op<'_>, i: usize, addr: u32, width: u32, negative: bool, post: usize) {
+        let mut from = Vec::new();
+        if negative {
+            a.cmp_w(addr, 0);
+            from.push(a.fwd(Fix::BCond(LT)));
+        }
+        a.ldr_x(13, X21, CTX_DM_LEN);
+        a.add_xi(16, addr, width);
+        a.cmp_xx(16, 13);
+        from.push(a.fwd(Fix::BCond(HI)));
+        let k = kind(op);
+        let helper = if k < KINDS { k } else { H_GENERIC };
+        let save = self.snapshot();
+        let d = self.vs.len();
+        self.cold.push(Cold::Slow { from, save, helper, d, i, post });
+        a.ldr_x(17, X21, CTX_DM_PTR);
+    }
+
+    /// Op i typed, when its operands allow it; false leaves it to the
+    /// untyped code. `next`: op i + 1.
+    fn op(&mut self, a: &mut Asm, i: usize, op: &Op<'_>, next: Option<&Op<'_>>) -> bool {
+        let d = self.vs.len();
+        let ty = self.ty;
+        let two = d >= 2 && self.int(i, d - 2) && self.int(i, d - 1);
+        let one = d >= 1 && self.int(i, d - 1);
+        match op {
+            Op::GetLocal { index } => {
+                let off = *index as usize * 16;
+                self.vs.push(V::Local(off, ty.lt[i] == Ty::Int));
+            }
+            Op::PushInt { value } => self.vs.push(V::Imm(*value)),
+            Op::PushUint { value } if *value <= i32::MAX as u32 => self.vs.push(V::Imm(*value as i32)),
+            Op::Nop | Op::CoerceA => {}
+            Op::Pop => {
+                self.vs.pop();
+            }
+            Op::SetLocal { index } | Op::StoreLocal { index } => {
+                let dst = *index as usize * 16;
+                // A `GetLocal` of it not read yet reads the old value.
+                for k in 0..d - 1 {
+                    if matches!(self.vs[k], V::Local(off, _) if off == dst) {
+                        self.flush(a, k);
+                    }
+                }
+                match self.vs[d - 1] {
+                    V::Local(src, _) if src == dst => {}
+                    V::Local(src, _) => {
+                        a.ldr_q(0, X19, src);
+                        a.str_q(0, X19, dst);
+                    }
+                    V::Mem | V::MemInt => {
+                        a.ldr_q(0, X19, self.slot(d - 1));
+                        a.str_q(0, X19, dst);
+                    }
+                    v => store_v(a, self.lay, dst, v),
+                }
+                if matches!(op, Op::SetLocal { .. }) {
+                    self.vs.pop();
+                }
+            }
+            Op::Dup => {
+                // Only one entry can be x14 / x15, which the untyped code
+                // may reuse: a copy of it is a copy in the frame.
+                if self.vs[d - 1] == V::Regs {
+                    self.flush(a, d - 1);
+                }
+                let top = self.vs[d - 1];
+                match top {
+                    V::W(r) => {
+                        let r2 = self.alloc(a);
+                        a.e(0x2A00_03E0 | r << 16 | r2); // mov w<r2>, w<r>
+                        self.vs.push(V::W(r2));
+                    }
+                    V::Mem | V::MemInt => {
+                        a.ldr_q(0, X19, self.slot(d - 1));
+                        a.str_q(0, X19, self.slot(d));
+                        self.vs.push(top);
+                    }
+                    _ => self.vs.push(top),
+                }
+            }
+            Op::Swap => {
+                let (x, y) = (self.vs[d - 2], self.vs[d - 1]);
+                if matches!(x, V::Mem | V::MemInt) || matches!(y, V::Mem | V::MemInt) {
+                    self.flush(a, d - 2);
+                    self.flush(a, d - 1);
+                    a.ldr_q(0, X19, self.slot(d - 2));
+                    a.ldr_q(1, X19, self.slot(d - 1));
+                    a.str_q(1, X19, self.slot(d - 2));
+                    a.str_q(0, X19, self.slot(d - 1));
+                }
+                self.vs.swap(d - 2, d - 1);
+            }
+            Op::CoerceI if one => {} // already one
+            Op::Add | Op::Subtract | Op::Multiply | Op::URShift if two && ty.wrap[i] => self.bin(a, i, op, ty.round[i]),
+            Op::URShift if two && matches!(self.vs[d - 1], V::Imm(c) if c & 31 != 0) => self.bin(a, i, op, false),
+            Op::AddI | Op::SubtractI | Op::MultiplyI | Op::BitAnd | Op::BitOr | Op::BitXor | Op::LShift | Op::RShift
+                if two =>
+            {
+                self.bin(a, i, op, false)
+            }
+            Op::BitNot | Op::Sxi1 | Op::Sxi8 | Op::Sxi16 | Op::IncrementI | Op::DecrementI | Op::NegateI if one => {
+                self.un(a, i, op)
+            }
+            Op::Li8 | Op::Li16 | Op::Li32 | Op::Lf32 | Op::Lf64 if one => self.load(a, i, op),
+            Op::Si8 | Op::Si16 | Op::Si32 if two => self.store(a, i, op),
+            Op::Sf32 | Op::Sf64
+                if d >= 2 && one && (self.int(i, d - 2) || (self.vs[d - 2] == V::Mem && ty.st(i, d - 2) == Ty::Num)) =>
+            {
+                self.store(a, i, op)
+            }
+            Op::Equals | Op::StrictEquals | Op::LessThan | Op::LessEquals | Op::GreaterThan | Op::GreaterEquals
+                if two && ty.fuse[i] =>
+            {
+                match next {
+                    Some(&Op::IfTrue { offset }) => self.fused(a, i, op, offset, true),
+                    Some(&Op::IfFalse { offset }) => self.fused(a, i, op, offset, false),
+                    _ => return false,
+                }
+            }
+            _ => return false,
+        }
+        self.count += 1;
+        true
+    }
+
+    /// Two ints to one: `fold2` for two constants.
+    fn bin(&mut self, a: &mut Asm, i: usize, op: &Op<'_>, round: bool) {
+        let d = self.vs.len();
+        if let (V::Imm(p), V::Imm(q)) = (self.vs[d - 2], self.vs[d - 1]) {
+            self.vs.pop();
+            self.vs[d - 2] = V::Imm(fold2(op, p, q));
+            return;
+        }
+        let y = self.src(a, i, d - 1, 11);
+        let x = self.src(a, i, d - 2, 10);
+        // The operands are read: their registers are free for the result.
+        self.vs.pop();
+        self.vs[d - 2] = V::Mem;
+        let rd = self.alloc(a);
+        emit_bin(a, op, rd, x, y, round);
+        self.vs[d - 2] = V::W(rd);
+    }
+
+    fn un(&mut self, a: &mut Asm, i: usize, op: &Op<'_>) {
+        let d = self.vs.len();
+        if let V::Imm(v) = self.vs[d - 1] {
+            self.vs[d - 1] = V::Imm(match op {
+                Op::BitNot => !v,
+                Op::Sxi1 => -(v & 1),
+                Op::Sxi8 => v as i8 as i32,
+                Op::Sxi16 => v as i16 as i32,
+                Op::IncrementI => v.wrapping_add(1),
+                Op::DecrementI => v.wrapping_sub(1),
+                _ => v.wrapping_neg(),
+            });
+            return;
+        }
+        let n = self.reg(a, i, d - 1, 10);
+        self.vs[d - 1] = V::Mem;
+        let rd = self.alloc(a);
+        a.e(match op {
+            Op::BitNot => 0x2A20_03E0 | n << 16 | rd, // mvn
+            Op::Sxi1 => 0x1300_0000 | n << 5 | rd,    // sbfx #0, #1
+            Op::Sxi8 => 0x1300_1C00 | n << 5 | rd,    // sxtb
+            Op::Sxi16 => 0x1300_3C00 | n << 5 | rd,   // sxth
+            Op::IncrementI => 0x1100_0400 | n << 5 | rd,
+            Op::DecrementI => 0x5100_0400 | n << 5 | rd,
+            _ => 0x4B00_03E0 | n << 16 | rd, // NegateI: neg
+        });
+        self.vs[d - 1] = V::W(rd);
+    }
+
+    /// `li8` .. `lf64` at an int address: in the view, in range, or the
+    /// helper. An int result in a register, a Number in the frame.
+    fn load(&mut self, a: &mut Asm, i: usize, op: &Op<'_>) {
+        let d = self.vs.len();
+        let width = match op {
+            Op::Li8 => 1,
+            Op::Li16 => 2,
+            Op::Lf64 => 8,
+            _ => 4,
+        };
+        self.view(a, i);
+        let addr = self.reg(a, i, d - 1, 12);
+        self.bounds(a, op, i, addr, width, false, d);
+        self.vs[d - 1] = V::Mem;
+        match op {
+            Op::Lf32 | Op::Lf64 => {
+                if matches!(op, Op::Lf32) {
+                    a.mem_reg(MEM_LDR_S, 0, 17, addr);
+                    a.e(0x1E22_C000); // fcvt d0, s0
+                } else {
+                    a.mem_reg(MEM_LDR_D, 0, 17, addr);
+                }
+                let at = self.slot(d - 1);
+                let r = a.mov_x(9, self.lay.num_word);
+                a.str_x(r, X19, at);
+                a.str_d(0, X19, at + self.lay.num_off);
+            }
+            _ => {
+                let rd = self.alloc(a);
+                let m = match op {
+                    Op::Li8 => MEM_LDRB,
+                    Op::Li16 => MEM_LDRH,
+                    _ => MEM_LDR_W,
+                };
+                a.mem_reg(m, rd, 17, addr);
+                self.vs[d - 1] = V::W(rd);
+            }
+        }
+    }
+
+    /// `si8` .. `sf64`: the value (an int, or a Number in the frame for
+    /// `sf32` / `sf64`) at an int address.
+    fn store(&mut self, a: &mut Asm, i: usize, op: &Op<'_>) {
+        let d = self.vs.len();
+        let width = match op {
+            Op::Si8 => 1,
+            Op::Si16 => 2,
+            Op::Sf64 => 8,
+            _ => 4,
+        };
+        self.view(a, i);
+        let addr = self.reg(a, i, d - 1, 12);
+        let float = matches!(op, Op::Sf32 | Op::Sf64);
+        let mut val = 11;
+        if float && !self.int(i, d - 2) {
+            let at = self.slot(d - 2);
+            self.check_tag(a, i, at, self.lay.num_tag);
+            a.ldr_d(0, X19, at + self.lay.num_off);
+        } else {
+            val = self.reg(a, i, d - 2, 11);
+            if float {
+                a.e(0x1E62_0000 | val << 5); // scvtf d0, w<val>
+            }
+        }
+        self.bounds(a, op, i, addr, width, true, d - 2);
+        match op {
+            Op::Si8 => a.mem_reg(MEM_STRB, val, 17, addr),
+            Op::Si16 => a.mem_reg(MEM_STRH, val, 17, addr),
+            Op::Si32 => a.mem_reg(MEM_STR_W, val, 17, addr),
+            Op::Sf32 => {
+                a.e(0x1E62_4000); // fcvt s0, d0
+                a.mem_reg(MEM_STR_S, 0, 17, addr);
+            }
+            _ => a.mem_reg(MEM_STR_D, 0, 17, addr),
+        }
+        self.vs.truncate(d - 2);
+    }
+
+    /// A comparison of two ints and the `IfTrue` / `IfFalse` after it: one
+    /// `cmp`, one `b.cond`, the Bool never made.
+    fn fused(&mut self, a: &mut Asm, i: usize, op: &Op<'_>, offset: usize, nz: bool) {
+        let d = self.vs.len();
+        // The branch target and the next op find the rest in the frame.
+        for k in 0..d - 2 {
+            self.flush(a, k);
+        }
+        if offset <= i + 1 {
+            a.poll_timeout();
+            self.dm_ok = false;
+        }
+        let mut cond = match op {
+            Op::LessThan => LT,
+            Op::LessEquals => LE,
+            Op::GreaterThan => GT,
+            Op::GreaterEquals => GE,
+            _ => EQ,
+        };
+        if let (V::Imm(p), V::Imm(q)) = (self.vs[d - 2], self.vs[d - 1]) {
+            let t = match cond {
+                LT => p < q,
+                LE => p <= q,
+                GT => p > q,
+                GE => p >= q,
+                _ => p == q,
+            };
+            self.vs.truncate(d - 2);
+            if t == nz {
+                a.branch(Fix::B, Target::Op(offset));
+            }
+            self.skip = true;
+            return;
+        }
+        let y = self.src(a, i, d - 1, 11);
+        let x = self.src(a, i, d - 2, 10);
+        self.vs.truncate(d - 2);
+        match (x, y) {
+            (Src::Reg(n), Src::Reg(m)) => a.e(0x6B00_001F | m << 16 | n << 5), // cmp
+            (Src::Reg(n), Src::Imm(c)) => a.cmp_wi(n, c, 11),
+            (Src::Imm(c), Src::Reg(m)) => {
+                a.cmp_wi(m, c, 10);
+                // c < m is m > c.
+                cond = match cond {
+                    LT => GT,
+                    LE => GE,
+                    GT => LT,
+                    GE => LE,
+                    c => c,
+                };
+            }
+            (Src::Imm(_), Src::Imm(_)) => unreachable!(),
+        }
+        a.branch(Fix::BCond(if nz { cond } else { cond ^ 1 }), Target::Op(offset));
+        self.skip = true;
+    }
+}
+
+/// One `Cold` stub.
+fn emit_cold(a: &mut Asm, lay: &Layout, c: Cold) {
+    let gen_check = |a: &mut Asm| {
+        a.ldr_x(9, X21, CTX_GEN);
+        a.ldr_x(9, 9, 0);
+        a.ldr_x(10, X21, CTX_DM_GEN);
+        a.cmp_xx(9, 10);
+    };
+    match c {
+        Cold::Refresh { from, back, save, d, i } => {
+            let here = a.here();
+            a.set(from, here);
+            // h_dm keeps x19-x28: the entries in `POOL` are still there.
+            a.call(H_DM, 0, 0, 0, false);
+            gen_check(a);
+            a.branch(Fix::BCond(EQ), Target::Code(back));
+            for (at, v) in save {
+                store_v(a, lay, at, v);
+            }
+            a.call(H_DEOPT, d, i, 0, true);
+        }
+        Cold::Slow { from, save, helper, d, i, post } => {
+            let here = a.here();
+            for f in from {
+                a.set(f, here);
+            }
+            for (at, v) in save {
+                store_v(a, lay, at, v);
+            }
+            a.call(helper, d, i, post, true);
+            a.call(H_DEOPT, post, i + 1, 0, true);
+        }
+        Cold::TypeFail { from, save, d, i } => {
+            let here = a.here();
+            a.set(from, here);
+            for (at, v) in save {
+                store_v(a, lay, at, v);
+            }
+            a.call(H_TYPEFAIL, d, i, 0, false);
+            a.call(H_DEOPT, d, i, 0, true);
+        }
+    }
+}
+
+/// The code of one method: words, the start of each op, the exit.
+fn emit(
+    lay: &Layout,
+    ops: &[Op<'_>],
+    depth: &[u32],
+    target: &[bool],
+    nl: usize,
+    cache: bool,
+    this_scopes: usize,
+    cb: bool,
+    types: Option<&Types>,
+    check: bool,
+    guards: &FnvHashMap<usize, usize>,
+) -> Result<(Vec<u32>, Vec<usize>, usize, u64), String> {
+    let n = ops.len();
+    let slot = |d: usize| (nl + d) * 16;
+    let local0 = Op::GetLocal { index: 0 };
+    let mut a = Asm {
+        code: Vec::with_capacity(n * 4 + 16),
+        fixups: Vec::new(),
+    };
+    a.prologue();
+    // Room for the saves of `POOL`, filled or taken out at the end.
+    let pool_at = a.here();
+    for _ in POOL {
+        a.e(NOP);
+    }
+    let mut labels = vec![usize::MAX; n];
+    let mut tos = Tos::Mem;
+    let mut typer = types.map(|ty| Typer {
+        lay,
+        ty,
+        nl,
+        check,
+        vs: Vec::new(),
+        cold: Vec::new(),
+        used: 0,
+        dm_ok: false,
+        skip: false,
+        count: 0,
+    });
+    for i in 0..n {
+        let op = match &ops[i] {
+            Op::GetScopeObject { index } if (*index as usize) < this_scopes => &local0,
+            op => op,
+        };
+        if depth[i] == u32::MAX {
+            labels[i] = a.code.len();
+            tos = Tos::Mem;
+            if let Some(t) = &mut typer {
+                t.vs.clear();
+                t.dm_ok = false;
+            }
+            continue;
+        }
+        let d = depth[i] as usize;
+        if let Some(t) = &mut typer {
+            if t.skip {
+                // Emitted with the comparison before it (`Typer::fused`).
+                t.skip = false;
+                labels[i] = a.code.len();
+                continue;
+            }
+            // Jumps arrive with everything in the frame, of the types the
+            // other paths give it too.
+            if target[i] {
+                for k in 0..t.vs.len() {
+                    t.flush(&mut a, k);
+                }
+                t.vs.iter_mut().for_each(|v| *v = V::Mem);
+                t.dm_ok = false;
+            }
+            if t.vs.len() != d {
+                t.vs.clear();
+                t.vs.resize(d, V::Mem);
+            }
+            labels[i] = a.code.len();
+            if t.op(&mut a, i, op, ops.get(i + 1)) {
+                continue;
+            }
+            // The untyped code finds everything in the frame but its top,
+            // which can be its stack cache.
+            for k in 0..d.saturating_sub(1) {
+                t.flush(&mut a, k);
+            }
+            tos = match t.vs.last() {
+                Some(V::Local(off, _)) => Tos::Local(*off),
+                Some(V::Regs) => Tos::Regs,
+                Some(V::Mem | V::MemInt) | None => Tos::Mem,
+                Some(_) => {
+                    t.flush(&mut a, d - 1);
+                    Tos::Mem
+                }
+            };
+            // The untyped code owns its stack cache now: past this op the old
+            // top is either taken or in its frame slot. A `Local` left here
+            // would read the local again after the op, which may write it
+            // (SMBC's `getlocal 4, kill 4, setproperty` stored undefined).
+            if let Some(top) = t.vs.last_mut()
+                && matches!(top, V::Local(..) | V::Regs)
+            {
+                *top = V::Mem;
+            }
+            t.dm_ok = false;
+        } else {
+            // Jumps arrive with nothing cached: write it back on the way in.
+            if target[i] && tos != Tos::Mem {
+                flush(&mut a, tos, slot(d - 1));
+                tos = Tos::Mem;
+            }
+            labels[i] = a.code.len();
+        }
+        let consumer = cache
+            && match op {
+                Op::GetLocal { .. } | Op::SetLocal { .. } | Op::StoreLocal { .. } | Op::Pop => true,
+                Op::GetSlot { index } => !lay.obj_tags.is_empty() && slot(d - 1) < 4096 && *index < 4096,
+                Op::SetSlotNoCoerce { index } => {
+                    lay.header_ok && !lay.obj_tags.is_empty() && slot(d - 1) + 16 < 4096 && *index < 4096
+                }
+                _ => false,
+            };
+        if !consumer && tos != Tos::Mem {
+            flush(&mut a, tos, slot(d - 1));
+            tos = Tos::Mem;
+        }
+        match op {
+            Op::GetLocal { index } if cache => {
+                // The previous top is no longer the top: write it back.
+                if tos != Tos::Mem {
+                    flush(&mut a, tos, slot(d - 1));
+                }
+                tos = Tos::Local(*index as usize * 16);
+            }
+            Op::GetLocal { index } => {
+                a.ldr_q(0, X19, *index as usize * 16);
+                a.str_q(0, X19, slot(d));
+            }
+            Op::SetLocal { index } | Op::StoreLocal { index } => {
+                let dst = *index as usize * 16;
+                match tos {
+                    Tos::Mem => {
+                        a.ldr_q(0, X19, slot(d - 1));
+                        a.str_q(0, X19, dst);
+                    }
+                    Tos::Local(src) => {
+                        if src != dst {
+                            a.ldr_q(0, X19, src);
+                            a.str_q(0, X19, dst);
+                        }
+                    }
+                    Tos::Regs => {
+                        a.str_x(14, X19, dst);
+                        a.str_x(15, X19, dst + 8);
+                    }
+                }
+                // StoreLocal leaves the value on the stack, where it is.
+                if matches!(op, Op::SetLocal { .. }) {
+                    tos = Tos::Mem;
+                }
+            }
+            Op::Kill { index } => a.store_const(*index as usize * 16, bytes_of(Value::Undefined)),
+            Op::PushInt { value } => a.store_const(slot(d), bytes_of(Value::from(*value))),
+            Op::PushUint { value } => a.store_const(slot(d), bytes_of(Value::from(*value))),
+            Op::PushDouble { value } => a.store_const(slot(d), bytes_of(Value::from(*value))),
+            Op::PushTrue => a.store_const(slot(d), bytes_of(Value::from(true))),
+            Op::PushFalse => a.store_const(slot(d), bytes_of(Value::from(false))),
+            Op::PushNull => a.store_const(slot(d), bytes_of(Value::Null)),
+            Op::PushUndefined => a.store_const(slot(d), bytes_of(Value::Undefined)),
+            Op::Pop => tos = Tos::Mem,
+            Op::Nop | Op::CoerceA => {}
+            Op::Dup => {
+                a.ldr_q(0, X19, slot(d - 1));
+                a.str_q(0, X19, slot(d));
+            }
+            Op::Swap => {
+                a.ldr_q(0, X19, slot(d - 2));
+                a.ldr_q(1, X19, slot(d - 1));
+                a.str_q(1, X19, slot(d - 2));
+                a.str_q(0, X19, slot(d - 1));
+            }
+            Op::Jump { offset } | Op::PopJump { offset } => {
+                if *offset <= i {
+                    a.poll_timeout();
+                }
+                a.branch(Fix::B, Target::Op(*offset));
+            }
+            Op::LookupSwitch(ls) => {
+                // The index as the interpreter takes it (`lookup_switch`: the
+                // top as i32), then one compare per case, in the order of the
+                // table; anything else, a negative index included, is the
+                // default. Switches are short (Stencyl's behaviours, #130's
+                // round: 93 methods refused for this alone in The Little Who).
+                let cases: std::vec::Vec<usize> = ls.case_offsets.iter().map(|c| c.get()).collect();
+                let default = ls.default_offset.get();
+                if cases.iter().any(|&t| t <= i) || default <= i {
+                    a.poll_timeout();
+                }
+                a.call(H_SWITCH, d, 0, 0, false);
+                for (k, &t) in cases.iter().enumerate() {
+                    a.cmp_w(0, k as u32);
+                    a.branch(Fix::BCond(EQ), Target::Op(t));
+                }
+                a.branch(Fix::B, Target::Op(default));
+            }
+            Op::IfTrue { offset } | Op::IfFalse { offset } => {
+                if *offset <= i {
+                    a.poll_timeout();
+                }
+                let nz = matches!(op, Op::IfTrue { .. });
+                let top = slot(d - 1);
+                if lay.bool_ok && top + lay.bool_off < 4096 {

+static FLASHNX_GC_PHASE: AtomicU8 = AtomicU8::new(0);
+static FLASHNX_GC_ALLOC: AtomicU64 = AtomicU64::new(0);
+static FLASHNX_GC_US: AtomicU64 = AtomicU64::new(0);

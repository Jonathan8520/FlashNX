+const CTX_DM_PTR: usize = 16;
+const CTX_DM_LEN: usize = 24;
+const CTX_DM_GEN: usize = 32;
+const CTX_GEN: usize = 40;
+const CTX_POLL: usize = 48;
+
+/// A backward branch calls `h_timeout` once in this many, which counts them
+/// all for `timeout_check` (see `h_timeout`).
+const POLL_EVERY: u32 = 64;

+/// FlashNX: set by AS3 `System.gc()`, consumed by the next `update`.
+static FULL_GC_REQUESTED: AtomicBool = AtomicBool::new(false);
+
+/// FlashNX: arena size past which `GC_TIGHT_PACING` replaces the default.
+const GC_TIGHT_BYTES: usize = 256 * 1024 * 1024;
+/// Shorter sleep, and 0.7x the default work factors (each allocated byte buys
+/// more collection), so a cycle finishes after less allocation.
+const GC_TIGHT_PACING: gc_arena::metrics::Pacing = gc_arena::metrics::Pacing {
+    sleep_factor: 0.25,
+    min_sleep: 4096,
+    mark_factor: 0.07,
+    trace_factor: 0.28,
+    keep_factor: 0.035,
+    drop_factor: 0.14,
+    free_factor: 0.21,
+};
+
+/// FlashNX: live arena below which `gc_small_pacing` lets the collector sleep
+/// longer. Flash Player's own collector (MMgc `GCPolicyManager`) let a heap
+/// grow by a load factor that shrinks with its size, 2.5x under 10 MB down to
+/// 1.125x past 300 MB, and loosened it further whenever collecting took over a
+/// quarter of the time. gc-arena's default sleeps 0.5x the live heap whatever
+/// its size, so a game that allocates fast on a small heap never lets it rest:
+/// Happy Wheels (Box2D, a 29-37 MB arena) had the collector awake in three
+/// frames out of four, 6.3 ms of a 60 ms frame (2026-10-08).
+const GC_SMALL_BYTES: usize = 32 * 1024 * 1024;
+const GC_MID_BYTES: usize = 64 * 1024 * 1024;
+
+/// FlashNX: live arena size when the last cycle finished (0 before the first).
+/// The pacing is chosen on this rather than on the current total, which
+/// swings with the garbage of the cycle in progress and would switch the
+/// pacing back and forth between cycles.
+static FLASHNX_GC_LIVE: AtomicU64 = AtomicU64::new(0);
+
+/// FlashNX: `gc_small_pacing` on (default) or off (`gcsmall.off` marker, and
+/// the profiling build's A/B).
+static GC_SMALL: AtomicBool = AtomicBool::new(true);

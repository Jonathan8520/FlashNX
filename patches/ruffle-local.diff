+    // the .sol slightly lossy but finite, instead of crashing/freezing the player.
+    thread_local! {
+        static VISITING: std::cell::RefCell<std::collections::HashSet<usize>> =
+            std::cell::RefCell::new(std::collections::HashSet::new());

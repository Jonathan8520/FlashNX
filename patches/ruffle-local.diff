+/// FlashNX: a range of a byte buffer shared, without a copy, between a
+/// ByteArray and what is made of it: another ByteArray it is written into, and
+/// the movie `Loader.loadBytes` loads from it (`SwfMovie::from_shared_data`).
+/// Each holder that writes takes a private copy first.
+///
+/// Super Smash Flash 2 keeps every DAT file it downloads as a ByteArray
+/// (`URLLoader.data`), copies the SWF inside into a second ByteArray and loads
+/// that one: the same bytes three times, plus a copy per step of the load. The
+/// SWFs inside are uncompressed, so a movie's tags were byte for byte the
+/// ByteArray's: 212 MB of ByteArrays next to 224 MB of movies when it ran out
+/// of memory (2026-10-06).
+#[derive(Clone)]
+pub struct SharedBytes {
+    buf: Arc<Vec<u8>>,
+    start: usize,
+    end: usize,
+}
+
+impl SharedBytes {
+    pub fn new(buf: Vec<u8>) -> Self {
+        let end = buf.len();
+        Self {
+            buf: Arc::new(buf),
+            start: 0,
+            end,
+        }
+    }
+
+    #[inline]
+    pub fn as_slice(&self) -> &[u8] {
+        &self.buf[self.start..self.end]
+    }
+
+    #[inline]
+    pub fn len(&self) -> usize {
+        self.end - self.start
+    }
+
+    #[inline]
+    pub fn is_empty(&self) -> bool {
+        self.end == self.start
+    }
+
+    /// Bytes `start..end` of this range, clamped to it.
+    pub fn sub(&self, start: usize, end: usize) -> Self {
+        let end = end.min(self.len());
+        let start = start.min(end);
+        Self {
+            buf: self.buf.clone(),
+            start: self.start + start,
+            end: self.start + end,
+        }
+    }
+}
+
+impl Debug for SharedBytes {
+    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
+        write!(f, "SharedBytes({} bytes)", self.len())
+    }
+}
+
+/// FlashNX: a movie's data, its own or shared with a ByteArray (`SharedBytes`),
+/// counted while it lives (`live_movie_stats`), to tell on the console whether
+/// loaded SWFs are ever freed.
+struct MovieData(MovieBytes);
+
+enum MovieBytes {
+    Owned(Vec<u8>),
+    Shared(SharedBytes),
+}
+
+static LIVE_MOVIES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static LIVE_MOVIE_BYTES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+impl MovieData {
+    fn new(data: Vec<u8>) -> Self {
+        Self::counted(MovieBytes::Owned(data))
+    }
+
+    fn shared(data: SharedBytes) -> Self {
+        Self::counted(MovieBytes::Shared(data))
+    }
+
+    fn counted(bytes: MovieBytes) -> Self {
+        use std::sync::atomic::Ordering::Relaxed;
+        let data = Self(bytes);
+        LIVE_MOVIES.fetch_add(1, Relaxed);
+        LIVE_MOVIE_BYTES.fetch_add(data.as_slice().len() as u64, Relaxed);
+        data
+    }
+
+    #[inline]
+    fn as_slice(&self) -> &[u8] {
+        match &self.0 {
+            MovieBytes::Owned(data) => data,
+            MovieBytes::Shared(data) => data.as_slice(),
+        }
+    }
+}
+
+impl Clone for MovieData {
+    fn clone(&self) -> Self {
+        note_made(6);
+        match &self.0 {
+            MovieBytes::Owned(data) => Self::new(data.clone()),
+            MovieBytes::Shared(data) => Self::shared(data.clone()),
+        }
+    }
+}
+
+impl Drop for MovieData {
+    fn drop(&mut self) {
+        use std::sync::atomic::Ordering::Relaxed;
+        LIVE_MOVIES.fetch_sub(1, Relaxed);
+        LIVE_MOVIE_BYTES.fetch_sub(self.as_slice().len() as u64, Relaxed);
+    }
+}
+
+/// FlashNX: (movies alive, bytes of SWF data they hold).
+pub fn live_movie_stats() -> (u64, u64) {
+    use std::sync::atomic::Ordering::Relaxed;
+    (LIVE_MOVIES.load(Relaxed), LIVE_MOVIE_BYTES.load(Relaxed))
+}
+
+/// FlashNX: how many movies each constructor has made since boot, in the order
+/// empty, fake (length), fake (data), error, from_data, loaded image, copy. The
+/// census line prints them, so a count of live movies that keeps climbing says
+/// which path makes them.
+static MOVIES_MADE: [std::sync::atomic::AtomicU64; 7] =
+    [const { std::sync::atomic::AtomicU64::new(0) }; 7];
+
+fn note_made(kind: usize) {
+    MOVIES_MADE[kind].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// FlashNX: the counts behind `MOVIES_MADE`.
+pub fn movies_made() -> [u64; 7] {
+    std::array::from_fn(|i| MOVIES_MADE[i].load(std::sync::atomic::Ordering::Relaxed))
+}

@@ -0,0 +1,33 @@
+package {
+    import flash.display.DisplayObject;
+    import flash.display.MovieClip;
+
+    // Linked to the "Page" symbol: frame 1 places one child at depth 10,
+    // frame 2 is labelled "target" and places "childA" at depth 1.
+    public class Page extends MovieClip {
+
+        public var childA:Child;
+
+        public function Page() {
+            super();
+            trace("Page: ctor, currentFrame=" + currentFrame + " numChildren=" + numChildren);
+            // The frame 1 entry matters as much as the frame 2 one: registering
+            // a script for the frame the clip is already on marks a script
+            // pending, and a later goto retargets that pending slot at the
+            // frame it lands on. Without it the frame 2 script is deferred to
+            // the next construct pass and the bug does not appear.
+            addFrameScript(0, onFrame1, 1, onTargetFrame);
+        }
+
+        private function onFrame1():void {
+            trace("Page: frame 1 script, numChildren=" + numChildren);
+        }
+
+        private function onTargetFrame():void {
+            trace("Page: frame 2 script, currentFrame=" + currentFrame + " numChildren=" + numChildren);
+            var child:DisplayObject = getChildAt(0);
+            trace("Page: getChildAt(0) is " + (child == null ? "null" : "an object"));
+            trace("REPRO-PASS getChildAt(0).name=" + child.name);
+        }
+    }
+}

+pub(crate) fn flashnx_ticks() -> u64 {
+    #[cfg(target_arch = "aarch64")]
+    {
+        let v: u64;
+        unsafe { std::arch::asm!("mrs {}, cntpct_el0", out(reg) v, options(nostack)) };
+        v
+    }
+    #[cfg(not(target_arch = "aarch64"))]
+    {
+        0
+    }
+}

+/// FlashNX: `analyze` on CrossBridge-like code, and the code `emit` makes of
+/// it written to `<temp>/flashnx_jit_typed/<name>.bin` (with a `.map` of the
+/// op offsets), for `aarch64-none-elf-objdump -D -b binary -m aarch64`. Code
+/// memory is the console's: never touched here.
+#[cfg(test)]
+mod typed_tests {
+    use super::*;
+
+    #[unsafe(no_mangle)]
+    extern "C" fn flashnx_jit_init(_: usize, _: *mut *mut u8, _: *mut *mut u8) -> u32 {
+        0
+    }
+    #[unsafe(no_mangle)]
+    extern "C" fn flashnx_jit_flush(_: *mut u8, _: *mut u8, _: usize) {}
+
+    fn build(name: &str, ops: &[Op<'static>], entry: &[Ty], ms: usize) -> Types {
+        build_with(name, ops, entry, ms, &FnvHashMap::default())
+    }
+
+    fn build_with(name: &str, ops: &[Op<'static>], entry: &[Ty], ms: usize, guards: &FnvHashMap<usize, usize>) -> Types {
+        let (depth, target) = shape(ops, ms, guards).unwrap();
+        let ty = analyze(ops, &depth, &target, entry, guards).expect("analyze");
+        let mut lay = Layout::default();
+        probe_bool(&mut lay);
+        probe_numbers(&mut lay);
+        assert!(lay.words_ok);
+        let (code, labels, exit, typed) =
+            emit(&lay, ops, &depth, &target, entry.len(), true, 0, true, Some(&ty), true, guards).unwrap();
+        let dir = std::env::temp_dir().join("flashnx_jit_typed");
+        std::fs::create_dir_all(&dir).unwrap();
+        let bytes: Vec<u8> = code.iter().flat_map(|w| w.to_le_bytes()).collect();
+        std::fs::write(dir.join(format!("{name}.bin")), bytes).unwrap();
+        let mut map = format!("int_tag {} int_word {:x} num_word {:x}\n", lay.int_tag, lay.int_word, lay.num_word);
+        for (i, op) in ops.iter().enumerate() {
+            map += &format!("{:x} {i} {}\n", labels[i] * 4, op_name(op));
+        }
+        map += &format!("{:x} (exit)\n", exit * 4);
+        std::fs::write(dir.join(format!("{name}.map")), map).unwrap();
+        println!("{name}: {typed} of {} ops typed, {} words, {}", ops.len(), code.len(), dir.display());
+        ty
+    }

diff --git a/core/src/flashnx_as3prof.rs b/core/src/flashnx_as3prof.rs
new file mode 100644
index 000000000..0a3e04218
--- /dev/null
+++ b/core/src/flashnx_as3prof.rs
@@ -0,0 +1,212 @@
+//! FlashNX: per-method AVM2 profiler.
+//!
+//! The sampling profiler sees the interpreter (`run_actions`, `op_call_prop_void`)
+//! but never WHICH ActionScript function it is running. Super Smash Flash 2
+//! spends 40-50 ms of a 60 ms fight frame inside its own code (its whole engine
+//! runs from `Event.RENDER`), and the first fight runs at 45-60 fps while the
+//! next ones run at 16-18: the question is which of the game's functions grow.
+//!
+//! Every call that goes through `function::exec` (bytecode and native methods)
+//! is timed with the CPU's counter: exclusive time (own code, callees removed),
+//! inclusive time, call count. `report()` prints the top entries and resets.
+//!
+//! Off unless `sdmc:/switch/FlashNX/as3prof.on` exists at game launch: when off,
+//! the cost is one relaxed atomic load per call.
+
+use fnv::FnvHashMap;
+use std::cell::RefCell;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+
+pub fn set_as3_profiler(on: bool) {
+    ENABLED.store(on, Ordering::Relaxed);
+    STATE.with(|s| {
+        if let Ok(mut s) = s.try_borrow_mut() {
+            *s = State::default();
+        }
+    });
+}
+
+#[inline]
+pub fn enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed)
+}
+
+#[cfg(target_arch = "aarch64")]
+#[inline]
+fn now() -> u64 {
+    let t: u64;
+    unsafe { std::arch::asm!("mrs {}, cntpct_el0", out(reg) t, options(nomem, nostack)) };
+    t
+}
+
+#[cfg(target_arch = "aarch64")]
+fn ticks_per_us() -> f64 {
+    let f: u64;
+    unsafe { std::arch::asm!("mrs {}, cntfrq_el0", out(reg) f, options(nomem, nostack)) };
+    f as f64 / 1_000_000.0
+}
+
+#[cfg(not(target_arch = "aarch64"))]
+#[inline]
+fn now() -> u64 {
+    use std::sync::OnceLock;
+    static T0: OnceLock<std::time::Instant> = OnceLock::new();
+    T0.get_or_init(std::time::Instant::now).elapsed().as_nanos() as u64
+}
+
+#[cfg(not(target_arch = "aarch64"))]
+fn ticks_per_us() -> f64 {
+    1000.0
+}
+
+struct Entry {
+    name: String,
+    native: bool,
+    calls: u64,
+    excl: u64,
+    incl: u64,
+}
+
+struct Frame {
+    entry: u32,
+    start: u64,
+    child: u64,
+}
+
+#[derive(Default)]
+struct State {
+    index: FnvHashMap<usize, u32>,
+    entries: Vec<Entry>,
+    stack: Vec<Frame>,
+    /// Time spent in outermost calls only (no double counting).
+    top_level: u64,
+    calls: u64,
+}
+
+thread_local! {
+    static STATE: RefCell<State> = RefCell::new(State::default());
+}
+
+/// Ends the timing of one call when dropped (also on early `return Err`).
+pub struct Guard {
+    active: bool,
+}
+
+impl Guard {
+    /// `key` identifies the method (its `Gc` address); `name` is only built
+    /// the first time a method is seen.
+    #[inline]
+    pub fn enter(key: usize, native: bool, name: impl FnOnce() -> String) -> Guard {
+        if !enabled() {
+            return Guard { active: false };
+        }
+        let active = STATE.with(|s| {
+            let Ok(mut s) = s.try_borrow_mut() else {
+                return false;
+            };
+            let s = &mut *s;
+            let entry = match s.index.get(&key) {
+                Some(&i) => i,
+                None => {
+                    let i = s.entries.len() as u32;
+                    s.entries.push(Entry {
+                        name: name(),
+                        native,
+                        calls: 0,
+                        excl: 0,
+                        incl: 0,
+                    });
+                    s.index.insert(key, i);
+                    i
+                }
+            };
+            s.stack.push(Frame {
+                entry,
+                start: now(),
+                child: 0,
+            });
+            true
+        });
+        Guard { active }
+    }
+}
+
+impl Drop for Guard {
+    #[inline]
+    fn drop(&mut self) {
+        if !self.active {
+            return;
+        }
+        let t = now();
+        STATE.with(|s| {
+            let Ok(mut s) = s.try_borrow_mut() else {
+                return;
+            };
+            let s = &mut *s;
+            let Some(f) = s.stack.pop() else {
+                return;
+            };
+            let elapsed = t.saturating_sub(f.start);
+            let e = &mut s.entries[f.entry as usize];
+            e.calls += 1;
+            e.incl += elapsed;
+            e.excl += elapsed.saturating_sub(f.child);
+            s.calls += 1;
+            match s.stack.last_mut() {
+                Some(parent) => parent.child += elapsed,
+                None => s.top_level += elapsed,
+            }
+        });
+    }
+}
+
+/// Top `n` methods by exclusive time since the last report, then reset the
+/// counters (names are kept). Empty when the profiler is off or idle.
+pub fn report(n: usize) -> String {
+    if !enabled() {
+        return String::new();
+    }
+    STATE.with(|s| {
+        let Ok(mut s) = s.try_borrow_mut() else {
+            return String::new();
+        };
+        let s = &mut *s;
+        if s.calls == 0 {
+            return String::new();
+        }
+        let tpu = ticks_per_us();
+        let ms = |t: u64| t as f64 / tpu / 1000.0;
+        let mut order: Vec<usize> = (0..s.entries.len())
+            .filter(|&i| s.entries[i].calls > 0)
+            .collect();
+        order.sort_by(|&a, &b| s.entries[b].excl.cmp(&s.entries[a].excl));
+        let mut out = format!(
+            "as3prof: {} calls, {:.0} ms in AS3 (outermost calls), {} methods seen\n",
+            s.calls,
+            ms(s.top_level),
+            order.len()
+        );
+        for &i in order.iter().take(n) {
+            let e = &s.entries[i];
+            out.push_str(&format!(
+                "as3prof:   excl {:7.1} ms  incl {:7.1} ms  calls {:8}  {:6.2} us/call  {}{}\n",
+                ms(e.excl),
+                ms(e.incl),
+                e.calls,
+                ms(e.excl) * 1000.0 / e.calls as f64,
+                if e.native { "[native] " } else { "" },
+                e.name
+            ));
+        }
+        for e in &mut s.entries {
+            e.calls = 0;
+            e.excl = 0;
+            e.incl = 0;
+        }
+        s.top_level = 0;
+        s.calls = 0;
+        out
+    })
+}
diff --git a/core/src/flashnx_avm2ops.rs b/core/src/flashnx_avm2ops.rs
new file mode 100644
index 000000000..37c4b2b27
--- /dev/null
+++ b/core/src/flashnx_avm2ops.rs
@@ -0,0 +1,137 @@
+//! FlashNX: AVM2 opcode census for the measurement build (`flashnx_instr`).
+//!
+//! Fireboy & Watergirl 2 spends 84 ms of a 90 ms frame in ActionScript, and the
+//! sampling profiler puts the time in the interpreter's machinery (dispatch,
+//! stack traffic, calls) rather than in any one opcode. What it cannot say is
+//! how MANY opcodes run, which pairs come back most often (the candidates for
+//! fused opcodes, like avmplus' `peephole.tbl`), and how small the called
+//! methods are (the candidates for inlining). This counts all three.
+//!
+//! Single-threaded by construction: AVM2 only runs on the Ruffle worker.
+
+const N: usize = 256;
+
+static mut COUNTS: [u64; N] = [0; N];
+static mut PAIRS: [u32; N * N] = [0; N * N];
+static mut PREV: usize = 0;
+static mut NAMES: [Option<&'static str>; N] = [None; N];
+/// Bytecode calls by size of the callee's optimized body, in ops:
+/// <=4, <=8, <=16, <=32, <=64, more.
+static mut BODY: [u64; 6] = [0; 6];
+static mut NATIVE_CALLS: u64 = 0;
+
+/// `i` is the op's discriminant; `op` is only formatted the first time.
+#[inline(always)]
+pub fn count(i: usize, op: &dyn core::fmt::Debug) {
+    let i = i & (N - 1);
+    unsafe {
+        let counts = &raw mut COUNTS;
+        if (*counts)[i] == 0 {
+            name(i, op);
+        }
+        (*counts)[i] += 1;
+        let pairs = &raw mut PAIRS;
+        let p = (&raw mut PREV).read() * N + i;
+        (*pairs)[p] = (*pairs)[p].wrapping_add(1);
+        (&raw mut PREV).write(i);
+    }
+}
+
+#[cold]
+#[inline(never)]
+fn name(i: usize, op: &dyn core::fmt::Debug) {
+    if unsafe { (*(&raw const NAMES))[i].is_some() } {
+        return;
+    }
+    let full = format!("{op:?}");
+    let end = full.find([' ', '{', '(']).unwrap_or(full.len());
+    let short: &'static str = Box::leak(full[..end].to_string().into_boxed_str());
+    unsafe { (*(&raw mut NAMES))[i] = Some(short) };
+}
+
+/// One bytecode method entered, with `ops` ops in its optimized body.
+#[inline(always)]
+pub fn bytecode_call(ops: usize) {
+    let b = match ops {
+        0..=4 => 0,
+        5..=8 => 1,
+        9..=16 => 2,
+        17..=32 => 3,
+        33..=64 => 4,
+        _ => 5,
+    };
+    unsafe { (*(&raw mut BODY))[b] += 1 };
+}
+
+#[inline(always)]
+pub fn native_call() {
+    unsafe { *(&raw mut NATIVE_CALLS) += 1 };
+}
+
+/// Totals since the last report over `frames` frames, then reset.
+pub fn report(frames: u64) -> String {
+    let frames = frames.max(1);
+    unsafe {
+        let counts = &mut *(&raw mut COUNTS);
+        let pairs = &mut *(&raw mut PAIRS);
+        let names = &*(&raw const NAMES);
+        let body = &mut *(&raw mut BODY);
+        let native = &mut *(&raw mut NATIVE_CALLS);
+        let total: u64 = counts.iter().sum();
+        if total == 0 {
+            return String::new();
+        }
+        let nm = |i: usize| names[i].unwrap_or("?");
+        let calls: u64 = body.iter().sum();
+        let mut out = format!(
+            "avm2ops: {} ops ({}/frame), {} bytecode calls ({}/frame, one per {} ops), {} native calls ({}/frame)\n",
+            total,
+            total / frames,
+            calls,
+            calls / frames,
+            total / calls.max(1),
+            *native,
+            *native / frames
+        );
+        out.push_str(&format!(
+            "avm2calls: callee body <=4 ops {:.1}%, <=8 {:.1}%, <=16 {:.1}%, <=32 {:.1}%, <=64 {:.1}%, more {:.1}%\n",
+            body[0] as f64 * 100.0 / calls.max(1) as f64,
+            body[1] as f64 * 100.0 / calls.max(1) as f64,
+            body[2] as f64 * 100.0 / calls.max(1) as f64,
+            body[3] as f64 * 100.0 / calls.max(1) as f64,
+            body[4] as f64 * 100.0 / calls.max(1) as f64,
+            body[5] as f64 * 100.0 / calls.max(1) as f64,
+        ));
+        let mut order: Vec<usize> = (0..N).filter(|&i| counts[i] > 0).collect();
+        order.sort_by(|&a, &b| counts[b].cmp(&counts[a]));
+        for &i in order.iter().take(40) {
+            out.push_str(&format!(
+                "avm2op {:<22} n={:<11} share={:.2}%\n",
+                nm(i),
+                counts[i],
+                counts[i] as f64 * 100.0 / total as f64
+            ));
+        }
+        let mut top: Vec<(u32, usize)> = pairs
+            .iter()
+            .enumerate()
+            .filter(|&(_, &n)| n > 0)
+            .map(|(p, &n)| (n, p))
+            .collect();
+        top.sort_unstable_by(|a, b| b.0.cmp(&a.0));
+        for &(n, p) in top.iter().take(50) {
+            out.push_str(&format!(
+                "avm2pair {:>22} > {:<22} n={:<11} share={:.2}%\n",
+                nm(p / N),
+                nm(p % N),
+                n,
+                n as f64 * 100.0 / total as f64
+            ));
+        }
+        counts.iter_mut().for_each(|c| *c = 0);
+        pairs.iter_mut().for_each(|c| *c = 0);
+        body.iter_mut().for_each(|c| *c = 0);
+        *native = 0;
+        out
+    }
+}

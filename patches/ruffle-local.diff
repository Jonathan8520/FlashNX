+//! FlashNX: a baseline JIT for AVM2 bytecode (AArch64, Switch build only).
+//!
+//! Fireboy & Watergirl 2 runs 2.65 million AVM2 ops per frame at ~57 CPU
+//! cycles each: the interpreter loop pays one shared, badly predicted indirect
+//! branch per op, and reloads and stores its stack pointer from memory on every
+//! push and pop. Flash Player compiled ActionScript to machine code instead.
+//!
+//! This is the simplest compiler that removes both costs, the "baseline JIT"
+//! of the literature (template / copy-and-patch JITs):
+//!
+//! - The stack depth of every op is known before running (the verifier
+//!   guarantees it, we recompute it), so each stack slot is a fixed offset from
+//!   the frame base kept in x19: no stack pointer at all in compiled code.
+//! - Locals, constants, `Pop`, `Dup`, `Swap` and branches are a few inline
+//!   instructions (`ldr q0` / `str q0` of the 16-byte `Value`).
+//! - Every other op calls `h_op::<K>`, one instantiation per op kind: it sets
+//!   the interpreter's stack pointer, runs the very same `op_*` handler as the
+//!   interpreter, and checks the depth it left against the one we computed.
+//!   Behaviour is the interpreter's by construction, and a wrong entry in
+//!   `effect` is caught at the first run: the method goes back to the
+//!   interpreter at the next op, and is never compiled again.
+//!
+//! Some ops also have an inline fast path, because their helper was the cost:
+//! `getslot` on an object (13 % of Fireboy's frame through its helper),
+//! `iftrue` / `iffalse` on a `Bool`, and arithmetic, comparisons and int
+//! coercions when both operands are `Number`s or both `int`s (the exact
+//! results of the interpreter's own fast paths, overflow and NaN included). They read Ruffle's data in place, so the
+//! layout they rely on is measured on real values first (`Layout`): a type
+//! of object whose layout was not checked takes the helper.
+//!
+//! `callmethod` from compiled code goes straight into the callee's compiled
+//! code when that is safe (`fast_call`, the way avmplus' JIT calls an
+//! early-bound method through its `_implGPR`): callee compiled, no
+//! `arguments` / `...rest`, as many arguments as parameters, and arguments
+//! that already have their parameter's type (or only need `int` -> `Number`
+//! or `undefined` -> `null`). It skips the generic `call_method_with_args` ->
+//! `exec` -> `init_from_method` path, which re-checks and re-coerces
+//! everything on each of Fireboy's 42 000 calls a frame.
+//!
+//! `getproperty` with an int index on a dense `Array` has its own helper
+//! (no dynamic dispatch, no borrow counting); `setslot` without coercion is
+//! inline when the object is not black for the GC (a black object takes the
+//! helper, whose `Gc::write` runs gc-arena's barrier).
+//!
+//! Methods with exception handlers, `lookupswitch` or unknown ops stay
+//! interpreted. Code memory comes from libnx's `jitCreate` (CodeMemory, which
+//! hbloader allows on Mesosphère), see `cpp/src/flashnx_jit.c`.
+
+use super::*;
+use crate::avm2::object::{Object, ScriptObjectData};
+use fnv::FnvHashMap;
+use std::sync::atomic::{AtomicBool, Ordering as AtomicOrdering};
+#[cfg(feature = "flashnx_instr")]
+use std::sync::atomic::AtomicU64;
+
+unsafe extern "C" {
+    fn flashnx_jit_init(size: usize, rw: *mut *mut u8, rx: *mut *mut u8) -> u32;
+    fn flashnx_jit_flush(rw: *mut u8, rx: *mut u8, len: usize);
+}
+
+const REJECTED: usize = usize::MAX;
+/// Compile on the second call: one-shot initializers stay interpreted.
+const THRESHOLD: usize = 2;
+/// Code memory, taken once from the heap and reused by every game (`reset`).
+/// Super Smash Flash 2, the biggest seen, compiles ~6 MB of it.
+const CODE_SIZE: usize = 16 << 20;
+/// Helper table: 0..KINDS = `h_op::<K>`, then the special helpers.
+const KINDS: usize = 160;
+/// Domain memory view for the inline `li*` / `si*` ops (`h_dm`).
+const H_DM: usize = 246;
+/// `check` found no int where `analyze` proved one.
+const H_TYPEFAIL: usize = 244;
+/// Typed code gives the rest of the call to the interpreter.
+const H_DEOPT: usize = 245;
+/// `lookupswitch`'s index (`h_switch`).
+const H_SWITCH: usize = 247;
+const H_ARRAY_GET: usize = 248;
+const H_CALL: usize = 249;
+const H_GENERIC: usize = 250;
+const H_TRUTHY: usize = 251;
+const H_TIMEOUT: usize = 252;
+const H_RETURN: usize = 253;
+/// Whether a callee copied in place is the receiver's (`h_guard`).
+const H_GUARD: usize = 243;
+
+/// A small callee seen at a `callmethod` while its caller was interpreted is
+/// copied in place of the call (`plan_inlines`). Off from the `jitinline.off`
+/// marker.
+static INLINE: AtomicBool = AtomicBool::new(true);
+
+pub fn set_inline(on: bool) {
+    INLINE.store(on, AtomicOrdering::Relaxed);
+}
+
+/// A method stays interpreted for up to this many calls while some of its
+/// `callmethod`s have not run yet, so `plan_inlines` knows their callees.
+const INLINE_WAIT: usize = 4;
+/// The biggest callee copied, in ops. 40 left out 284 sites of Happy Wheels.
+const INLINE_MAX_OPS: usize = 64;
+/// Copies taken in on 2026-10-30, beyond the first ones: callees of more than
+/// `INLINE_FIRST_OPS` ops, or holding calls, script globals or properties
+/// by name (`wide`). Off, their guards make the call: the profiling build's
+/// A/B.
+const INLINE_FIRST_OPS: usize = 40;
+static INLINE_WIDE: AtomicBool = AtomicBool::new(true);
+
+pub fn set_inline_wide(on: bool) {
+    INLINE_WIDE.store(on, AtomicOrdering::Relaxed);
+}
+
+/// Low bit of `CodeInfo::expect` (a method's box address, 8-aligned): a
+/// copy `INLINE_WIDE` turns off.
+const EXPECT_WIDE: usize = 1;
+/// Stack slots a method may grow by for its copies (`flashnx_frame_extra`).
+const INLINE_MAX_STACK: usize = 64;
+
+static ENABLED: AtomicBool = AtomicBool::new(true);
+/// `callmethod` straight into compiled code (`fast_call`); the profiling
+/// build's A/B switches it.
+static DIRECT_CALLS: AtomicBool = AtomicBool::new(true);
+
+pub fn set_direct_calls(on: bool) {
+    DIRECT_CALLS.store(on, AtomicOrdering::Relaxed);
+}
+
+/// The one-entry stack cache of compiled code (`Tos`); off from the
+/// `jittos.off` marker.
+static TOS_CACHE: AtomicBool = AtomicBool::new(true);
+/// Profiling build: every method is compiled twice, the second time without
+/// the stack cache, so the A/B windows can run either (`ALT`).
+static DUAL: AtomicBool = AtomicBool::new(false);
+/// Run the second compilation where there is one.
+static ALT: AtomicBool = AtomicBool::new(false);
+
+pub fn set_tos_cache(on: bool) {
+    TOS_CACHE.store(on, AtomicOrdering::Relaxed);
+}
+
+/// The paths written for CrossBridge (FlasCC) code: domain memory and int
+/// ops inline, `getscopeobject` of `this` as local 0, `setslot` of an int,
+/// direct calls to bound methods. Off from the `jitcb.off` marker.
+static CROSSBRIDGE: AtomicBool = AtomicBool::new(true);
+
+pub fn set_crossbridge(on: bool) {
+    CROSSBRIDGE.store(on, AtomicOrdering::Relaxed);
+}
+
+/// Ints out of their `Value`s where `analyze` proves them (`Typer`), with
+/// the CrossBridge paths. Off from the `jitint.off` marker.
+static INTS: AtomicBool = AtomicBool::new(true);
+
+pub fn set_ints(on: bool) {
+    INTS.store(on, AtomicOrdering::Relaxed);
+}
+
+/// Typed code checks the tag of every int it reads from the frame
+/// (`Cold::TypeFail`): a wrong proof is counted and its method interpreted.
+/// Off from the `jitcheck.off` marker.
+static CHECK: AtomicBool = AtomicBool::new(true);
+
+pub fn set_check(on: bool) {
+    CHECK.store(on, AtomicOrdering::Relaxed);
+}
+
+pub fn set_dual(on: bool) {
+    DUAL.store(on, AtomicOrdering::Relaxed);
+}
+
+pub fn set_alt(on: bool) {
+    ALT.store(on, AtomicOrdering::Relaxed);
+}
+
+pub fn set_enabled(on: bool) {
+    ENABLED.store(on, AtomicOrdering::Relaxed);
+}
+
+#[inline(always)]
+pub fn enabled() -> bool {
+    ENABLED.load(AtomicOrdering::Relaxed)
+}
+
+type Act = Activation<'static, 'static>;
+
+/// What the compiled code and the helpers share. Machine code reads the
+/// first six fields, at the `CTX_*` offsets.
+#[repr(C)]
+struct Ctx {
+    frame: *mut Value<'static>,
+    helpers: *const usize,
+    /// This activation's domain memory as `h_dm` last saw it: its bytes,
+    /// their length, and the value of `FLASHNX_BYTES_GEN` then (`u64::MAX`:
+    /// not taken yet). The inline `li*` / `si*` use it while the counter, read
+    /// through `gen_ptr`, has not moved.
+    dm_ptr: *mut u8,
+    dm_len: usize,
+    dm_gen: u64,
+    gen_ptr: *const u64,
+    /// Backward branches left before the next `h_timeout` (`poll_timeout`).
+    poll: u32,
+    act: *mut Act,
+    ops: *const Op<'static>,
+    num_locals: usize,
+    result: Option<Result<Value<'static>, Error<'static>>>,
+    resume_ip: usize,
+    /// The code's callees copied in place (`CodeInfo`), or null.
+    info: *const CodeInfo,
+}
+
+/// What code compiled with callees copied in place (`splice`) needs at run
+/// time, behind the pointer in its header: the op list it was compiled from
+/// (helpers read their op there), the method's op each of those comes from
+/// (`u32::MAX`: a callee's), the callee each guard expects (`h_guard`), and
+/// the frame it needs.
+struct CodeInfo {
+    ops: Vec<Op<'static>>,
+    orig: Vec<u32>,
+    expect: Vec<usize>,
+    frame: usize,
+}
+
+/// Where the interpreter takes over from op `t` of the compiled list, in the
+/// method's own ops; `usize::MAX` inside a copied callee, which the method
+/// does not have (`run_compiled` turns it into an error).
+#[inline(always)]
+unsafe fn orig_ip(c: &Ctx, t: usize) -> usize {
+    if c.info.is_null() {
+        return t;
+    }
+    let info = unsafe { &*c.info };
+    match info.orig.get(t) {
+        Some(&o) if o != u32::MAX => o as usize,
+        _ => usize::MAX,
+    }
+}

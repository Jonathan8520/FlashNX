+/// A texture that lives outside any atlas — its own GL object, suitable as
+/// an FBO color attachment for `render_offscreen` and as a filter pass
+/// source/destination. Used when Ruffle creates a BitmapHandle for caching
+/// (cacheAsBitmap, BitmapData.draw, filter cache). Owns the GL texture.
+struct StandaloneTexture {
+    texture: GLuint,
+    width: u32,
+    height: u32,
+}
+
+impl Drop for StandaloneTexture {
+    fn drop(&mut self) {
+        unsafe { glDeleteTextures(1, &self.texture) };
+    }
+}
+
+impl std::fmt::Debug for StandaloneTexture {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "StandaloneTexture(id={}, {}x{})", self.texture, self.width, self.height)
+    }
+}
+
+/// BitmapHandle payload for standalone (non-atlas) textures. Behaves as
+/// the second BitmapHandle variant — code paths that take a BitmapHandle
+/// must try `as_standalone_bitmap` before falling back to
+/// `as_switch_bitmap`. Cheap to clone (Arc), drops the GL texture when the
+/// last Arc dies.
+#[derive(Clone, Debug)]
+struct StandaloneBitmap(Arc<StandaloneTexture>);
+impl BitmapHandleImpl for StandaloneBitmap {}
+
+/// No-op SyncHandle. Ruffle expects something back from
+/// `render_offscreen` / `apply_filter` to confirm the work was scheduled;
+/// it only matters for `resolve_sync_handle` (BitmapData.draw → readback
+/// to pixel buffer), which we don't implement yet. Returning this lets
+/// the rest of the pipeline keep working.
+#[derive(Debug)]
+struct NoOpSyncHandle;
+impl SyncHandle for NoOpSyncHandle {}
+
+/// Pool of standalone RGBA textures keyed by `(width, height)`. The
+/// filter pipeline allocates temporaries (blur intermediate, in-place
+/// staging for ColorMatrix when source == destination, etc.) and would
+/// otherwise create+destroy GL textures multiple times per frame. The
+/// pool returns whatever bucket entry exists, allocating fresh on miss.
+///
+/// Each entry is fully transparent and uninitialised between borrows
+/// (callers must clear before drawing — the filter passes do this
+/// implicitly because they overwrite the whole viewport).
+///
+/// Sizes are normally a handful of distinct pairs per Mario 63 frame
+/// (one per cacheAsBitmap clip × filters in flight), so a flat HashMap
+/// stays small (<10 buckets).
+struct FilterTexturePool {
+    buckets: std::collections::HashMap<(u32, u32), Vec<StandaloneTexture>>,
+}
+
+impl FilterTexturePool {
+    fn new() -> Self {
+        Self { buckets: std::collections::HashMap::new() }
+    }
+
+    fn acquire(&mut self, width: u32, height: u32) -> Option<StandaloneTexture> {
+        if let Some(bucket) = self.buckets.get_mut(&(width, height)) {
+            if let Some(tex) = bucket.pop() {
+                return Some(tex);
+            }
+        }
+        make_standalone_texture(width, height)
+    }
+
+    fn release(&mut self, tex: StandaloneTexture) {
+        let key = (tex.width, tex.height);
+        self.buckets.entry(key).or_default().push(tex);
+    }
+}
+
+/// Allocate a fresh RGBA8 texture of the given size, fully transparent,
+/// configured for FBO color attachment + linear sampling + clamp-to-edge.
+/// Returns None if the size is 0 in either dimension.
+fn make_standalone_texture(width: u32, height: u32) -> Option<StandaloneTexture> {
+    if width == 0 || height == 0 {
+        return None;
+    }
+    let mut tex: GLuint = 0;
+    unsafe {
+        glGenTextures(1, &mut tex);
+        glBindTexture(GL_TEXTURE_2D, tex);
+        glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+        // Initialise the texture data to fully transparent — Ruffle expects
+        // a "fresh" texture from create_empty_texture, and uninitialised
+        // GPU memory is whatever the previous tenant wrote.
+        let zeroes = vec![0u8; (width as usize) * (height as usize) * 4];
+        glTexImage2D(
+            GL_TEXTURE_2D,
+            0,
+            GL_RGBA8 as GLint,
+            width as GLsizei,
+            height as GLsizei,
+            0,
+            GL_RGBA,
+            GL_UNSIGNED_BYTE,
+            zeroes.as_ptr() as *const _,
+        );
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR as GLint);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR as GLint);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE as GLint);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE as GLint);
+        glBindTexture(GL_TEXTURE_2D, 0);
+    }
+    Some(StandaloneTexture {
+        texture: tex,
+        width,
+        height,
+    })
+}

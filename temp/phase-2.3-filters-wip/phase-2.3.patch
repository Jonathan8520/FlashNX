+    let w = width.max(1) as f32;
+    let h = height.max(1) as f32;
+    let a = m.a;
+    let b = m.b;
+    let c = m.c;
+    let d = m.d;
+    let tx = m.tx.to_pixels() as f32 - origin_x;
+    let ty = m.ty.to_pixels() as f32 - origin_y;
+    let sx = 2.0 / w;
+    let sy = if flip_y { -2.0 / h } else { 2.0 / h };
